import { Button, LineEdit, ListView } from "std-widgets.slint";

export struct NoteRow {
    name: string,
    path: string,
    relative-path: string,
    duration: string,
    preview: string,
    active: bool,
}

export struct TimerRow {
    name: string,
    elapsed: string,
    running: bool,
    color: color,
}

component GlowOrb inherits Rectangle {
    in property <color> glow-color;
    border-radius: self.width / 2;
    background: glow-color;
    opacity: 0.09;

    Rectangle {
        x: parent.width * 0.14;
        y: parent.height * 0.14;
        width: parent.width * 0.72;
        height: parent.height * 0.72;
        border-radius: self.width / 2;
        background: root.glow-color;
        opacity: 0.34;
    }
    Rectangle {
        x: parent.width * 0.3;
        y: parent.height * 0.3;
        width: parent.width * 0.4;
        height: parent.height * 0.4;
        border-radius: self.width / 2;
        background: root.glow-color;
        opacity: 0.34;
    }
}

component IconButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;
    height: 38px;
    border-radius: 10px;
    background: primary ? #10b981 : #152038;
    border-width: 1px;
    border-color: primary ? #34d39955 : #ffffff12;

    Text {
        text: root.label;
        color: primary ? #042f2e : #dce7f7;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => root.clicked(); }
}

export component AppWindow inherits Window {
    title: "mmStopWatch Native";
    preferred-width: 1040px;
    preferred-height: 680px;
    min-width: 780px;
    min-height: 520px;
    background: #070b14;

    in property <[NoteRow]> notes;
    in property <[TimerRow]> timers;
    in-out property <string> vault-path;
    in property <string> status-message: "Vyberte složku s Markdown poznámkami.";
    in property <bool> status-error: false;
    in property <int> timer-count: 0;
    in property <float> glow-a-x: 38;
    in property <float> glow-a-y: 18;
    in property <float> glow-b-x: 70;
    in property <float> glow-b-y: 70;

    callback choose-folder;
    callback refresh;
    callback search-changed(string);
    callback add-timer(int);
    callback toggle-timer(int);
    callback save-timer(int);
    callback discard-timer(int);

    GlowOrb {
        x: root.width * root.glow-a-x / 100 - 230px;
        y: root.height * root.glow-a-y / 100 - 230px;
        width: 460px;
        height: 460px;
        glow-color: #3b82f6;
    }
    GlowOrb {
        x: root.width * root.glow-b-x / 100 - 250px;
        y: root.height * root.glow-b-y / 100 - 250px;
        width: 500px;
        height: 500px;
        glow-color: #8b5cf6;
    }

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        Rectangle {
            height: 62px;
            border-radius: 16px;
            background: #0d1424ee;
            border-width: 1px;
            border-color: #ffffff12;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 12px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "mmStopWatch"; color: #f8fafc; font-size: 20px; font-weight: 700; }
                    Text { text: "Nativní Slint verze"; color: #71809b; font-size: 11px; }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.timer-count == 1 ? "1 časomíra" : root.timer-count + " časomíry";
                    color: #8fa0bc;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                IconButton { width: 92px; label: "Obnovit"; clicked => root.refresh(); }
                IconButton { width: 124px; label: "Vybrat složku"; primary: true; clicked => root.choose-folder(); }
            }
        }

        HorizontalLayout {
            spacing: 14px;

            Rectangle {
                width: 39%;
                border-radius: 16px;
                background: #0b1220ee;
                border-width: 1px;
                border-color: #ffffff12;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text { text: "POZNÁMKY"; color: #71809b; font-size: 11px; font-weight: 700; }
                    LineEdit {
                        placeholder-text: "Hledat poznámku…";
                        edited => root.search-changed(self.text);
                    }
                    Text {
                        text: root.vault-path == "" ? "Složka zatím není vybraná" : root.vault-path;
                        color: #52617a;
                        font-size: 10px;
                        overflow: elide;
                    }
                    ListView {
                        for note[index] in root.notes : Rectangle {
                            height: 76px;
                            border-radius: 11px;
                            background: touch.has-hover ? #18243a : note.active ? #102d2a : #111a2b;
                            border-width: 1px;
                            border-color: note.active ? #34d39955 : #ffffff0c;

                            HorizontalLayout {
                                padding: 11px;
                                spacing: 10px;
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: note.name; color: #e6edf7; font-size: 13px; font-weight: 600; overflow: elide; }
                                    Text { text: note.preview == "" ? note.relative-path : note.preview; color: #71809b; font-size: 10px; overflow: elide; }
                                    Text { text: note.duration; color: note.active ? #6ee7b7 : #38bdf8; font-size: 11px; }
                                }
                                Text { text: note.active ? "AKTIVNÍ" : "+"; color: note.active ? #6ee7b7 : #94a3b8; font-size: note.active ? 9px : 22px; vertical-alignment: center; }
                            }
                            touch := TouchArea { clicked => root.add-timer(index); }
                        }
                    }
                }
            }

            Rectangle {
                border-radius: 16px;
                background: #0b1220ee;
                border-width: 1px;
                border-color: #ffffff12;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text { text: "ČASOMÍRY"; color: #71809b; font-size: 11px; font-weight: 700; }

                    if root.timer-count == 0 : Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text { text: "00:00:00.00"; color: #23314b; font-size: 34px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: "Vyberte poznámku vlevo a spusťte měření."; color: #64748b; font-size: 12px; horizontal-alignment: center; }
                        }
                    }

                    if root.timer-count > 0 : ListView {
                        for timer[index] in root.timers : Rectangle {
                            height: 118px;
                            border-radius: 14px;
                            background: #111a2b;
                            border-width: 1px;
                            border-color: timer.running ? timer.color : #ffffff10;

                            Rectangle { width: 4px; background: timer.color; border-radius: 2px; }
                            VerticalLayout {
                                padding: 14px;
                                spacing: 9px;
                                HorizontalLayout {
                                    Text { text: timer.name; color: #e8eef7; font-size: 14px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                                    Text { text: timer.running ? "BĚŽÍ" : "PAUZA"; color: timer.running ? #6ee7b7 : #71809b; font-size: 10px; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: timer.elapsed; color: #f8fafc; font-size: 26px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    IconButton { width: 74px; label: timer.running ? "Pauza" : "Spustit"; primary: !timer.running; clicked => root.toggle-timer(index); }
                                    IconButton { width: 62px; label: "Uložit"; clicked => root.save-timer(index); }
                                    IconButton { width: 40px; label: "×"; clicked => root.discard-timer(index); }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 30px;
            background: transparent;
            Text {
                text: root.status-message;
                color: root.status-error ? #fb7185 : #71809b;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
