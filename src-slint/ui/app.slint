import { LineEdit, ListView } from "std-widgets.slint";

export struct NoteRow {
    name: string,
    path: string,
    relative-path: string,
    duration: string,
    preview: string,
    tags: string,
    pinned: bool,
    active: bool,
}

export struct TimerRow {
    name: string,
    elapsed: string,
    added: string,
    running: bool,
    color: color,
    estimate-minutes: int,
    estimate-progress: float,
    estimate-status: string,
    expired: bool,
}

export struct StatsRow {
    name: string,
    duration: string,
    count: int,
}

component AmbientOrb inherits Rectangle {
    in property <color> glow-color;
    border-radius: self.width / 2;
    background: glow-color;
    opacity: 0.045;

    Rectangle {
        x: parent.width * 0.18;
        y: parent.height * 0.18;
        width: parent.width * 0.64;
        height: parent.height * 0.64;
        border-radius: self.width / 2;
        background: root.glow-color;
        opacity: 0.18;
    }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> danger: false;
    callback clicked;
    height: 30px;
    border-radius: 7px;
    background: touch.pressed ? #3f3f46 : touch.has-hover ? #303036 : active ? #27272a : #18181b;
    border-width: 1px;
    border-color: danger ? #ef444455 : active ? #71717a66 : #ffffff0b;

    Text {
        text: root.label;
        color: root.danger ? #fb7185 : root.active ? #fafafa : #a1a1aa;
        font-size: 11px;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => root.clicked(); }
}

component RoundAction inherits Rectangle {
    in property <string> label;
    in property <color> accent: #a1a1aa;
    in property <bool> filled: false;
    callback clicked;
    border-radius: self.width / 2;
    background: touch.pressed ? #3f3f46 : touch.has-hover ? #2b2b30 : filled ? accent : #202024;
    border-width: 1px;
    border-color: filled ? accent : #ffffff12;

    Text {
        text: root.label;
        color: filled ? #09090b : accent;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => root.clicked(); }
}

component EstimatePreset inherits Rectangle {
    in property <int> minutes;
    in property <bool> selected;
    callback clicked;
    height: 25px;
    border-radius: 6px;
    background: touch.has-hover ? #3f3f46 : selected ? #3f3f46 : #27272a;
    border-width: 1px;
    border-color: selected ? #a1a1aa66 : #ffffff08;
    Text {
        text: root.minutes;
        color: root.selected ? #fafafa : #a1a1aa;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => root.clicked(); }
}

component TimerCard inherits Rectangle {
    in property <TimerRow> timer;
    in property <int> row-index;
    callback toggle;
    callback save;
    callback discard;
    callback set-estimate(int);
    height: 191px;
    border-radius: 15px;
    background: #111113f2;
    border-width: 1px;
    border-color: timer.running ? timer.color : #ffffff0c;
    clip: true;

    Rectangle {
        x: 0;
        width: 3px;
        height: parent.height;
        background: root.timer.color;
    }
    Rectangle {
        x: -80px;
        y: 18px;
        width: 210px;
        height: 160px;
        border-radius: 105px;
        background: root.timer.color;
        opacity: root.timer.running ? 0.075 : 0.035;
    }

    VerticalLayout {
        padding-left: 18px;
        padding-right: 15px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;

        HorizontalLayout {
            height: 23px;
            spacing: 8px;
            Text {
                text: root.timer.name;
                color: #e4e4e7;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: root.timer.running ? "BĚŽÍ" : "PAUZA";
                color: root.timer.running ? root.timer.color : #71717a;
                font-size: 9px;
                font-weight: 700;
                vertical-alignment: center;
            }
            SmallButton { width: 30px; label: "×"; danger: true; clicked => root.discard(); }
        }

        HorizontalLayout {
            height: 25px;
            spacing: 5px;
            Text { width: 37px; text: "Odhad"; color: #71717a; font-size: 10px; vertical-alignment: center; }
            EstimatePreset { width: 29px; minutes: 15; selected: root.timer.estimate-minutes == 15; clicked => root.set-estimate(15); }
            EstimatePreset { width: 29px; minutes: 25; selected: root.timer.estimate-minutes == 25; clicked => root.set-estimate(25); }
            EstimatePreset { width: 29px; minutes: 30; selected: root.timer.estimate-minutes == 30; clicked => root.set-estimate(30); }
            EstimatePreset { width: 29px; minutes: 45; selected: root.timer.estimate-minutes == 45; clicked => root.set-estimate(45); }
            EstimatePreset { width: 29px; minutes: 60; selected: root.timer.estimate-minutes == 60; clicked => root.set-estimate(60); }
            EstimatePreset { width: 31px; minutes: 90; selected: root.timer.estimate-minutes == 90; clicked => root.set-estimate(90); }
            EstimatePreset { width: 34px; minutes: 120; selected: root.timer.estimate-minutes == 120; clicked => root.set-estimate(120); }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.timer.estimate-minutes > 0 : VerticalLayout {
            height: 24px;
            spacing: 4px;
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: #27272a;
                Rectangle {
                    width: parent.width * root.timer.estimate-progress;
                    height: parent.height;
                    border-radius: 2px;
                    background: root.timer.expired ? #fb7185 : root.timer.color;
                }
            }
            Text {
                text: root.timer.estimate-status;
                color: root.timer.expired ? #fb7185 : #71717a;
                font-size: 9px;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.timer.elapsed;
                    color: #fafafa;
                    font-size: 29px;
                    font-weight: 700;
                    letter-spacing: -0.5px;
                    vertical-alignment: bottom;
                }
                Text {
                    text: root.timer.added;
                    color: root.timer.color;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            RoundAction {
                width: 42px;
                height: 42px;
                label: root.timer.running ? "Ⅱ" : "▶";
                accent: root.timer.color;
                filled: !root.timer.running;
                clicked => root.toggle();
            }
            RoundAction {
                width: 42px;
                height: 42px;
                label: "✓";
                accent: #a1a1aa;
                clicked => root.save();
            }
        }
    }
}

component TimerTableRow inherits Rectangle {
    in property <TimerRow> timer;
    callback toggle;
    callback save;
    callback discard;
    height: 66px;
    border-radius: 10px;
    background: #18181bd9;
    border-width: 1px;
    border-color: timer.running ? timer.color : #ffffff0b;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle { width: 3px; height: 38px; border-radius: 2px; background: root.timer.color; }
        Text { horizontal-stretch: 1; text: root.timer.name; color: #e4e4e7; font-size: 12px; font-weight: 600; overflow: elide; vertical-alignment: center; }
        Text { width: 72px; text: root.timer.estimate-minutes > 0 ? root.timer.estimate-minutes + " min" : "—"; color: #71717a; font-size: 10px; vertical-alignment: center; }
        Text { width: 136px; text: root.timer.elapsed; color: #fafafa; font-size: 17px; font-weight: 700; vertical-alignment: center; }
        RoundAction { width: 34px; height: 34px; label: root.timer.running ? "Ⅱ" : "▶"; accent: root.timer.color; filled: !root.timer.running; clicked => root.toggle(); }
        RoundAction { width: 34px; height: 34px; label: "✓"; clicked => root.save(); }
        SmallButton { width: 30px; label: "×"; danger: true; clicked => root.discard(); }
    }
}

component OverlayLayer inherits Rectangle {
    in-out property <bool> onboarding-visible;
    in-out property <bool> settings-open;
    in-out property <int> settings-tab;
    in-out property <string> settings-nick;
    in-out property <string> settings-frontmatter;
    in-out property <string> settings-estimate-key;
    in-out property <string> settings-time-format;
    in-out property <string> settings-language;
    in-out property <string> settings-daily-goal;
    in-out property <string> settings-auto-refresh;
    in-out property <bool> settings-notifications;
    in-out property <string> settings-notification-interval;
    in-out property <bool> new-note-open;
    in-out property <string> new-note-filename;
    in-out property <string> new-note-time;
    in-out property <string> new-note-tags;
    in-out property <bool> close-guard-open;
    in property <string> vault-path;
    callback choose-folder;
    callback save-settings;
    callback create-note;
    callback close-save-all;
    callback close-discard-all;
    background: transparent;

    if root.settings-open : Rectangle {
        background: #000000b8;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 610px);
            height: Math.min(parent.height - 40px, 500px);
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    height: 30px;
                    Text { text: "Nastavení"; color: #fafafa; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                    SmallButton { width: 30px; label: "×"; clicked => { root.settings-open = false; } }
                }
                HorizontalLayout {
                    height: 33px;
                    spacing: 5px;
                    SmallButton { horizontal-stretch: 1; label: "Obecné"; active: root.settings-tab == 0; clicked => { root.settings-tab = 0; } }
                    SmallButton { horizontal-stretch: 1; label: "Frontmatter"; active: root.settings-tab == 1; clicked => { root.settings-tab = 1; } }
                    SmallButton { horizontal-stretch: 1; label: "Upozornění"; active: root.settings-tab == 2; clicked => { root.settings-tab = 2; } }
                    SmallButton { horizontal-stretch: 1; label: "Cíle"; active: root.settings-tab == 3; clicked => { root.settings-tab = 3; } }
                    SmallButton { horizontal-stretch: 1; label: "Profily"; active: root.settings-tab == 4; clicked => { root.settings-tab = 4; } }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 11px;
                    background: #111113;
                    border-width: 1px;
                    border-color: #ffffff0a;

                    if root.settings-tab == 0 : VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: "Přezdívka profilu"; color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-nick; placeholder-text: "nick"; }
                        Text { text: "Jazyk rozhraní"; color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-language; placeholder-text: "cs"; }
                        Text { text: "Automatické obnovení (minuty, 0 = nikdy)"; color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-auto-refresh; placeholder-text: "10"; }
                        Text { text: root.vault-path == "" ? "Není vybraná složka" : root.vault-path; color: #52525b; font-size: 9px; overflow: elide; }
                        SmallButton { width: 180px; label: "Změnit složku poznámek"; clicked => root.choose-folder(); }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.settings-tab == 1 : VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: "Pole s odpracovaným časem"; color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-frontmatter; placeholder-text: "Timework"; }
                        Text { text: "Pole s časovým odhadem"; color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-estimate-key; placeholder-text: "timeEstimate"; }
                        Text { text: "Formát času"; color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-time-format; placeholder-text: "HH:mm:ss"; }
                        Text { text: "Změny jsou ukládány do existujícího config.json bez odstranění neznámých polí."; color: #52525b; font-size: 9px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.settings-tab == 2 : VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: "Pravidelné připomenutí"; color: #e4e4e7; font-size: 12px; font-weight: 600; }
                        Text { text: "Připomenutí respektuje interval automatické kontroly a neběží, když není aktivní žádný timer."; color: #71717a; font-size: 10px; wrap: word-wrap; }
                        SmallButton {
                            width: 150px;
                            label: root.settings-notifications ? "Zapnuto" : "Vypnuto";
                            active: root.settings-notifications;
                            clicked => { root.settings-notifications = !root.settings-notifications; }
                        }
                        Text { text: "Interval připomenutí v minutách (0 = nikdy)"; color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-notification-interval; placeholder-text: "60"; }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.settings-tab == 3 : VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: "Denní cíl v hodinách"; color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-daily-goal; placeholder-text: "8.0"; }
                        Text { text: "Cíl se používá ve statistikách, kalendáři a reportech."; color: #52525b; font-size: 9px; }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.settings-tab == 4 : VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: "Aktivní vault"; color: #a1a1aa; font-size: 10px; }
                        Text { text: root.vault-path; color: #e4e4e7; font-size: 11px; overflow: elide; }
                        Text { text: "Profil: " + (root.settings-nick == "" ? "bez názvu" : root.settings-nick); color: #71717a; font-size: 10px; }
                        SmallButton { width: 180px; label: "Vybrat jiný vault"; clicked => root.choose-folder(); }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                HorizontalLayout {
                    height: 34px;
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { width: 100px; label: "Zrušit"; clicked => { root.settings-open = false; } }
                    SmallButton { width: 120px; label: "Uložit"; active: true; clicked => root.save-settings(); }
                }
            }
        }
    }

    if root.new-note-open : Rectangle {
        background: #000000b8;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 420px);
            height: 340px;
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                HorizontalLayout {
                    height: 30px;
                    Text { text: "Nová poznámka"; color: #fafafa; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                    SmallButton { width: 30px; label: "×"; clicked => { root.new-note-open = false; } }
                }
                Text { text: "Název souboru nebo existující podsložka/soubor.md"; color: #a1a1aa; font-size: 10px; }
                LineEdit { text <=> root.new-note-filename; placeholder-text: "2026-08-31.md"; }
                Text { text: "Počáteční čas"; color: #a1a1aa; font-size: 10px; }
                LineEdit { text <=> root.new-note-time; placeholder-text: "00:00:00"; }
                Text { text: "Tagy oddělené čárkou"; color: #a1a1aa; font-size: 10px; }
                LineEdit { text <=> root.new-note-tags; placeholder-text: "projekt, klient"; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 34px;
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { width: 100px; label: "Zrušit"; clicked => { root.new-note-open = false; } }
                    SmallButton { width: 120px; label: "Vytvořit"; active: true; clicked => root.create-note(); }
                }
            }
        }
    }

    if root.close-guard-open : Rectangle {
        background: #000000b8;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 440px);
            height: 300px;
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text { text: "Probíhající časomíry"; color: #fafafa; font-size: 18px; font-weight: 700; }
                Text { text: "Před zavřením aplikace můžete všechny rozpracované časy bezpečně uložit, zahodit, nebo se vrátit zpět."; color: #a1a1aa; font-size: 11px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                SmallButton { height: 38px; label: "✓  Uložit vše a zavřít"; active: true; clicked => root.close-save-all(); }
                SmallButton { height: 38px; label: "Zahodit vše a zavřít"; danger: true; clicked => root.close-discard-all(); }
                SmallButton { height: 34px; label: "Zrušit"; clicked => { root.close-guard-open = false; } }
            }
        }
    }

    if root.onboarding-visible : Rectangle {
        background: #09090bf4;
        AmbientOrb {
            x: parent.width / 2 - 260px;
            y: parent.height / 2 - 260px;
            width: 520px;
            height: 520px;
            glow-color: #10b981;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 480px);
            height: 310px;
            border-radius: 18px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #10b98144;
            VerticalLayout {
                padding: 28px;
                spacing: 14px;
                Text { text: "mmStopWatch"; color: #fafafa; font-size: 25px; font-weight: 700; horizontal-alignment: center; }
                Text { text: "Lehká nativní časomíra pro Markdown a Obsidian"; color: #a1a1aa; font-size: 11px; horizontal-alignment: center; }
                Rectangle { height: 1px; background: #ffffff0d; }
                Text { text: "Vyberte kořenovou složku s poznámkami. Pokud obsahuje existující .mmST profil, nastavení i historie se načtou automaticky."; color: #71717a; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; }
                Rectangle { vertical-stretch: 1; }
                SmallButton { height: 42px; label: "Vybrat složku poznámek"; active: true; clicked => root.choose-folder(); }
                Text { text: "Data zůstávají pouze ve vašem vaultu."; color: #52525b; font-size: 9px; horizontal-alignment: center; }
            }
        }
    }
}

component NoteCard inherits Rectangle {
    in property <NoteRow> note;
    callback open;
    callback pin;
    height: 103px;
    border-radius: 12px;
    background: touch.has-hover ? #27272ad9 : note.active ? #202323e8 : #18181bcc;
    border-width: 1px;
    border-color: note.active ? #10b98144 : #ffffff08;
    clip: true;

    touch := TouchArea { clicked => root.open(); }
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            height: 17px;
            Text { text: root.note.relative-path; color: #52525b; font-size: 9px; overflow: elide; vertical-alignment: center; }
            SmallButton { width: 24px; height: 20px; label: root.note.pinned ? "◆" : "◇"; active: root.note.pinned; clicked => root.pin(); }
        }
        HorizontalLayout {
            Text { text: root.note.name; color: #e4e4e7; font-size: 12px; font-weight: 600; overflow: elide; }
            Text { text: root.note.active ? "▶" : root.note.duration; color: root.note.active ? #34d399 : #a1a1aa; font-size: 11px; font-weight: 600; vertical-alignment: center; }
        }
        Text { text: root.note.tags; color: #71717a; font-size: 9px; overflow: elide; }
        Text { text: root.note.preview; color: #52525b; font-size: 9px; overflow: elide; }
    }
}

export component AppWindow inherits Window {
    title: "mmStopWatch";
    preferred-width: 900px;
    preferred-height: 600px;
    min-width: 760px;
    min-height: 500px;
    background: #09090b;

    in property <[NoteRow]> notes;
    in property <[TimerRow]> timers;
    in-out property <string> vault-path;
    in property <string> status-message: "Vyberte složku s Markdown poznámkami.";
    in property <bool> status-error: false;
    in property <int> timer-count: 0;
    in-out property <bool> table-view: false;
    in-out property <int> layout-columns: 1;
    in property <int> note-count: 0;
    in property <string> total-duration: "00:00:00";
    in-out property <bool> onboarding-visible: false;
    in-out property <bool> settings-open: false;
    in-out property <int> settings-tab: 0;
    in-out property <string> settings-nick: "";
    in-out property <string> settings-frontmatter: "Timework";
    in-out property <string> settings-estimate-key: "timeEstimate";
    in-out property <string> settings-time-format: "HH:mm:ss";
    in-out property <string> settings-language: "cs";
    in-out property <string> settings-daily-goal: "8.0";
    in-out property <string> settings-auto-refresh: "10";
    in-out property <bool> settings-notifications: true;
    in-out property <string> settings-notification-interval: "60";
    in-out property <bool> new-note-open: false;
    in-out property <string> new-note-filename: "";
    in-out property <string> new-note-time: "";
    in-out property <string> new-note-tags: "";
    in-out property <bool> close-guard-open: false;
    in-out property <bool> stats-open: false;
    in property <string> stats-total: "00:00:00";
    in property <string> stats-today: "00:00:00";
    in property <string> stats-week: "00:00:00";
    in property <string> stats-month: "00:00:00";
    in property <string> stats-average: "00:00:00";
    in property <string> stats-longest: "00:00:00";
    in property <int> stats-count: 0;
    in property <float> goal-progress: 0;
    in property <[StatsRow]> stats-notes;
    in property <float> glow-a-x: 38;
    in property <float> glow-a-y: 18;
    in property <float> glow-b-x: 70;
    in property <float> glow-b-y: 70;

    callback choose-folder;
    callback refresh;
    callback search-changed(string);
    callback add-timer(int);
    callback toggle-timer(int);
    callback save-timer(int);
    callback discard-timer(int);
    callback set-timer-estimate(int, int);
    callback set-timer-view(bool);
    callback set-layout-columns(int);
    callback toggle-pin(int);
    callback open-stats;
    callback export-report(bool);
    callback open-settings;
    callback save-settings;
    callback create-note;
    callback close-save-all;
    callback close-discard-all;

    for row in 10 : Rectangle {
        background: transparent;
        for column in 14 : Rectangle {
            x: column * 58px + 22px;
            y: row * 58px + 22px;
            width: 1px;
            height: 1px;
            border-radius: 1px;
            background: #ffffff;
            opacity: 0.045;
        }
    }

    AmbientOrb {
        x: root.width * root.glow-a-x / 100 - 230px;
        y: root.height * root.glow-a-y / 100 - 230px;
        width: 460px;
        height: 460px;
        glow-color: #0ea5e9;
    }
    AmbientOrb {
        x: root.width * root.glow-b-x / 100 - 260px;
        y: root.height * root.glow-b-y / 100 - 260px;
        width: 520px;
        height: 520px;
        glow-color: #8b5cf6;
    }

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            background: #09090bd9;

            VerticalLayout {
                padding: 8px;
                spacing: 7px;

                HorizontalLayout {
                    height: 30px;
                    spacing: 5px;
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { width: 31px; label: "☷"; active: !root.table-view; clicked => root.set-timer-view(false); }
                    SmallButton { width: 31px; label: "▦"; active: root.table-view; clicked => root.set-timer-view(true); }
                    SmallButton { width: 31px; label: "1"; active: root.layout-columns == 1; clicked => root.set-layout-columns(1); }
                    SmallButton { width: 31px; label: "2"; active: root.layout-columns == 2; clicked => root.set-layout-columns(2); }
                    SmallButton { width: 31px; label: "3"; active: root.layout-columns == 3; clicked => root.set-layout-columns(3); }
                    SmallButton { width: 31px; label: "4"; active: root.layout-columns == 4; clicked => root.set-layout-columns(4); }
                }

                if root.timer-count == 0 : Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                    VerticalLayout {
                        alignment: center;
                        spacing: 9px;
                        Text { text: "00:00:00.00"; color: #27272a; font-size: 37px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: "Kliknutím na poznámku spusťte novou časomíru"; color: #52525b; font-size: 11px; horizontal-alignment: center; }
                    }
                }

                if root.timer-count > 0 && !root.table-view : ListView {
                    for timer[index] in root.timers : TimerCard {
                        timer: timer;
                        row-index: index;
                        toggle => root.toggle-timer(index);
                        save => root.save-timer(index);
                        discard => root.discard-timer(index);
                        set-estimate(minutes) => root.set-timer-estimate(index, minutes);
                    }
                }

                if root.timer-count > 0 && root.table-view : ListView {
                    for timer[index] in root.timers : TimerTableRow {
                        timer: timer;
                        toggle => root.toggle-timer(index);
                        save => root.save-timer(index);
                        discard => root.discard-timer(index);
                    }
                }

                if root.status-message != "" : Text {
                    height: 18px;
                    text: root.status-message;
                    color: root.status-error ? #fb7185 : #52525b;
                    font-size: 9px;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            width: 320px;
            background: #0c0c0fee;
            border-width: 1px;
            border-color: #ffffff0d;

            VerticalLayout {
                padding: 6px;
                spacing: 7px;

                Rectangle {
                    height: 50px;
                    border-radius: 11px;
                    background: #18181bd9;
                    border-width: 1px;
                    border-color: #ffffff09;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text { text: "CELKOVÝ ČAS"; color: #52525b; font-size: 8px; font-weight: 700; }
                            Text { text: root.total-duration; color: #e4e4e7; font-size: 16px; font-weight: 700; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text { text: "POZNÁMKY"; color: #52525b; font-size: 8px; font-weight: 700; horizontal-alignment: right; }
                            Text { text: root.note-count; color: #a1a1aa; font-size: 15px; font-weight: 600; horizontal-alignment: right; }
                        }
                    }
                }

                HorizontalLayout {
                    height: 31px;
                    spacing: 5px;
                    SmallButton { horizontal-stretch: 1; label: "+ Nová"; clicked => { root.new-note-open = true; } }
                    SmallButton { width: 34px; label: "↻"; clicked => root.refresh(); }
                    SmallButton { width: 34px; label: "▥"; clicked => root.open-stats(); }
                    SmallButton { width: 34px; label: "⚙"; clicked => root.open-settings(); }
                }

                LineEdit {
                    height: 34px;
                    placeholder-text: "Hledat poznámku…";
                    edited => root.search-changed(self.text);
                }

                Text {
                    height: 13px;
                    text: root.vault-path == "" ? "Složka není vybraná" : root.vault-path;
                    color: #3f3f46;
                    font-size: 8px;
                    overflow: elide;
                }

                if root.notes.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                    Text {
                        text: root.vault-path == "" ? "Vyberte složku v nastavení" : "Žádné odpovídající poznámky";
                        color: #52525b;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.notes.length > 0 : ListView {
                    for note[index] in root.notes : NoteCard {
                        note: note;
                        open => root.add-timer(index);
                        pin => root.toggle-pin(index);
                    }
                }
            }
        }
    }

    if root.stats-open : Rectangle {
        background: #000000b8;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 680px);
            height: Math.min(parent.height - 40px, 520px);
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    height: 30px;
                    Text { text: "Statistiky"; color: #fafafa; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                    SmallButton { width: 30px; label: "×"; clicked => { root.stats-open = false; } }
                }

                HorizontalLayout {
                    height: 72px;
                    spacing: 8px;
                    Rectangle {
                        border-radius: 10px; background: #202024;
                        VerticalLayout { padding: 10px; spacing: 3px; Text { text: "DNES"; color: #71717a; font-size: 9px; } Text { text: root.stats-today; color: #34d399; font-size: 16px; font-weight: 700; } }
                    }
                    Rectangle {
                        border-radius: 10px; background: #202024;
                        VerticalLayout { padding: 10px; spacing: 3px; Text { text: "TENTO TÝDEN"; color: #71717a; font-size: 9px; } Text { text: root.stats-week; color: #38bdf8; font-size: 16px; font-weight: 700; } }
                    }
                    Rectangle {
                        border-radius: 10px; background: #202024;
                        VerticalLayout { padding: 10px; spacing: 3px; Text { text: "TENTO MĚSÍC"; color: #71717a; font-size: 9px; } Text { text: root.stats-month; color: #a78bfa; font-size: 16px; font-weight: 700; } }
                    }
                }

                Rectangle {
                    height: 44px;
                    border-radius: 10px;
                    background: #202024;
                    VerticalLayout {
                        padding: 9px;
                        spacing: 5px;
                        HorizontalLayout {
                            Text { text: "Denní cíl"; color: #a1a1aa; font-size: 10px; }
                            Text { text: Math.round(root.goal-progress * 100) + "%"; color: #34d399; font-size: 10px; font-weight: 700; horizontal-alignment: right; }
                        }
                        Rectangle { height: 4px; border-radius: 2px; background: #3f3f46; Rectangle { width: parent.width * root.goal-progress; height: parent.height; border-radius: 2px; background: #10b981; } }
                    }
                }

                HorizontalLayout {
                    height: 38px;
                    spacing: 14px;
                    Text { text: root.stats-count + " záznamů"; color: #a1a1aa; font-size: 11px; vertical-alignment: center; }
                    Text { text: "Celkem " + root.stats-total; color: #a1a1aa; font-size: 11px; vertical-alignment: center; }
                    Text { text: "Průměr " + root.stats-average; color: #71717a; font-size: 10px; vertical-alignment: center; }
                    Text { text: "Nejdelší " + root.stats-longest; color: #71717a; font-size: 10px; vertical-alignment: center; }
                }

                Text { height: 20px; text: "NEJČASTĚJŠÍ POZNÁMKY"; color: #71717a; font-size: 9px; font-weight: 700; }
                ListView {
                    for item in root.stats-notes : Rectangle {
                        height: 38px;
                        border-radius: 7px;
                        background: #202024;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text { text: item.name; color: #d4d4d8; font-size: 11px; overflow: elide; vertical-alignment: center; }
                            Text { text: item.count + "×"; color: #52525b; font-size: 10px; vertical-alignment: center; }
                            Text { text: item.duration; color: #34d399; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                }
                HorizontalLayout {
                    height: 32px;
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { width: 130px; label: "Týdenní report"; clicked => root.export-report(false); }
                    SmallButton { width: 130px; label: "Měsíční report"; clicked => root.export-report(true); }
                }
            }
        }
    }

    OverlayLayer {
        onboarding-visible <=> root.onboarding-visible;
        settings-open <=> root.settings-open;
        settings-tab <=> root.settings-tab;
        settings-nick <=> root.settings-nick;
        settings-frontmatter <=> root.settings-frontmatter;
        settings-estimate-key <=> root.settings-estimate-key;
        settings-time-format <=> root.settings-time-format;
        settings-language <=> root.settings-language;
        settings-daily-goal <=> root.settings-daily-goal;
        settings-auto-refresh <=> root.settings-auto-refresh;
        settings-notifications <=> root.settings-notifications;
        settings-notification-interval <=> root.settings-notification-interval;
        new-note-open <=> root.new-note-open;
        new-note-filename <=> root.new-note-filename;
        new-note-time <=> root.new-note-time;
        new-note-tags <=> root.new-note-tags;
        close-guard-open <=> root.close-guard-open;
        vault-path: root.vault-path;
        choose-folder => root.choose-folder();
        save-settings => root.save-settings();
        create-note => root.create-note();
        close-save-all => root.close-save-all();
        close-discard-all => root.close-discard-all();
    }
}
