import { LineEdit, ListView } from "std-widgets.slint";

export global I18n {
    in-out property <string> language: "cs";
    pure callback tr(string, string) -> string;
}

export struct NoteRow {
    name: string,
    path: string,
    relative-path: string,
    duration: string,
    preview: string,
    tags: string,
    pinned: bool,
    active: bool,
    accent: color,
}

export struct TimerRow {
    name: string,
    elapsed: string,
    added: string,
    running: bool,
    color: color,
    estimate-minutes: int,
    estimate-progress: float,
    estimate-status: string,
    expired: bool,
}

export struct TimerGridRow {
    a: TimerRow,
    b: TimerRow,
    c: TimerRow,
    d: TimerRow,
    has-a: bool,
    has-b: bool,
    has-c: bool,
    has-d: bool,
}

export struct StatsRow {
    name: string,
    duration: string,
    count: int,
}

export struct StatsDayRow {
    date: string,
    duration: string,
    progress: float,
    goal-met: bool,
}

export struct StatsCalendarDayRow {
    day: string,
    duration: string,
    progress: float,
    goal-met: bool,
    in-month: bool,
    today: bool,
}

export struct StatsCalendarWeekRow {
    monday: StatsCalendarDayRow,
    tuesday: StatsCalendarDayRow,
    wednesday: StatsCalendarDayRow,
    thursday: StatsCalendarDayRow,
    friday: StatsCalendarDayRow,
    saturday: StatsCalendarDayRow,
    sunday: StatsCalendarDayRow,
}

export struct StatsTrendRow {
    label: string,
    duration: string,
    progress: float,
}

export struct ProfileRow {
    nick: string,
    active: bool,
}

component AmbientOrb inherits Rectangle {
    in property <color> glow-color;
    // The gradient itself is static. Cache it so moving an orb only composites
    // a small layer instead of recalculating a large radial gradient.
    cache-rendering-hint: true;
    border-radius: self.width / 2;
    background: @radial-gradient(
        circle,
        glow-color.with-alpha(0.105) 0%,
        glow-color.with-alpha(0.045) 38%,
        glow-color.with-alpha(0.014) 62%,
        transparent 78%
    );
}

component SmallButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    min-width: 0px;
    height: 30px;
    border-radius: 7px;
    background: touch.pressed ? #3f3f46 : touch.has-hover && enabled ? #303036 : active ? #27272a : #18181b;
    opacity: enabled ? 1 : 0.35;
    border-width: 1px;
    border-color: danger ? #ef444455 : active ? #71717a66 : #ffffff0b;
    animate background { duration: 130ms; easing: ease-out; }
    animate border-color { duration: 160ms; easing: ease-out; }

    Text {
        width: parent.width;
        text: root.label;
        color: root.danger ? #fb7185 : root.active ? #fafafa : #a1a1aa;
        font-size: 11px;
        // Keep the button's layout metrics stable while the active state changes.
        font-weight: 500;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => root.clicked(); }
}

component RoundAction inherits Rectangle {
    in property <string> label;
    in property <color> accent: #a1a1aa;
    in property <bool> filled: false;
    callback clicked;
    border-radius: self.width / 2;
    background: touch.pressed ? #3f3f46 : touch.has-hover ? #2b2b30 : filled ? accent : #202024;
    border-width: 1px;
    border-color: filled ? accent : #ffffff12;
    animate background { duration: 130ms; easing: ease-out; }
    animate border-color { duration: 160ms; easing: ease-out; }

    Text {
        text: root.label;
        color: filled ? #09090b : accent;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => root.clicked(); }
}

component EstimatePreset inherits Rectangle {
    in property <int> minutes;
    in property <bool> selected;
    callback clicked;
    height: 25px;
    border-radius: 6px;
    background: touch.has-hover ? #3f3f46 : selected ? #3f3f46 : #27272a;
    border-width: 1px;
    border-color: selected ? #a1a1aa66 : #ffffff08;
    Text {
        text: root.minutes;
        color: root.selected ? #fafafa : #a1a1aa;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => root.clicked(); }
}

component TimerCard inherits Rectangle {
    in property <TimerRow> timer;
    in property <int> row-index;
    callback toggle;
    callback save;
    callback discard;
    callback set-estimate(int);
    callback custom-estimate;
    callback move(int);
    touch := TouchArea { }
    height: 252px;
    border-radius: 17px;
    background: touch.has-hover ? #1b1b1fe8 : #151518df;
    border-width: 1px;
    border-color: timer.expired ? #ef4444b8 : timer.running ? timer.color.with-alpha(0.58) : #ffffff14;
    clip: true;
    animate background { duration: 220ms; easing: ease-out; }
    animate border-color { duration: 220ms; easing: ease-out; }

    Rectangle {
        x: 0;
        width: 4px;
        height: parent.height;
        background: root.timer.color;
    }
    Rectangle {
        x: -90px;
        y: 20px;
        width: 300px;
        height: 230px;
        border-radius: 150px;
        background: @radial-gradient(
            circle,
            root.timer.color.with-alpha(root.timer.running ? 0.13 : 0.055) 0%,
            root.timer.color.with-alpha(root.timer.running ? 0.055 : 0.024) 45%,
            transparent 78%
        );
    }
    Rectangle {
        x: parent.width * 0.42;
        y: -110px;
        width: parent.width * 0.72;
        height: 270px;
        border-radius: 135px;
        background: @radial-gradient(circle, #a855f728 0%, #a855f70e 48%, transparent 78%);
    }

    VerticalLayout {
        padding-left: 28px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 20px;
        spacing: 10px;

        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            Text {
                text: root.timer.name;
                color: #e4e4e7;
                font-size: 15px;
                font-weight: 500;
                overflow: elide;
                vertical-alignment: center;
            }
            SmallButton { width: 28px; height: 28px; label: "‹"; clicked => root.move(-1); }
            SmallButton { width: 28px; height: 28px; label: "›"; clicked => root.move(1); }
            SmallButton { width: 34px; height: 28px; label: "×"; danger: true; clicked => root.discard(); }
        }

        if root.timer.estimate-minutes > 0 : VerticalLayout {
            height: 38px;
            spacing: 7px;
            HorizontalLayout {
                spacing: 7px;
                Text { text: "◷  " + root.timer.estimate-minutes + " min"; color: #a1a1aa; font-size: 11px; vertical-alignment: center; }
                Text { text: "·  " + root.timer.estimate-status; color: root.timer.expired ? #fb7185 : #a1a1aa; font-size: 11px; vertical-alignment: center; }
                Text { text: "·  " + Math.round(root.timer.estimate-progress * 100) + "%"; color: #71717a; font-size: 10px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: #3f3f46;
                Rectangle {
                    width: parent.width * root.timer.estimate-progress;
                    height: parent.height;
                    border-radius: 3px;
                    background: root.timer.expired ? #fb7185 : root.timer.color;
                    animate width { duration: 260ms; easing: linear; }
                }
            }
        }

        HorizontalLayout {
            height: 27px;
            spacing: 5px;
            if root.timer.estimate-minutes == 0 : EstimatePreset { width: 38px; minutes: 15; selected: false; clicked => root.set-estimate(15); }
            if root.timer.estimate-minutes == 0 : EstimatePreset { width: 38px; minutes: 25; selected: false; clicked => root.set-estimate(25); }
            if root.timer.estimate-minutes == 0 : EstimatePreset { width: 38px; minutes: 30; selected: false; clicked => root.set-estimate(30); }
            if root.timer.estimate-minutes == 0 : EstimatePreset { width: 38px; minutes: 45; selected: false; clicked => root.set-estimate(45); }
            if root.timer.estimate-minutes == 0 : EstimatePreset { width: 38px; minutes: 60; selected: false; clicked => root.set-estimate(60); }
            if root.timer.estimate-minutes == 0 : EstimatePreset { width: 38px; minutes: 90; selected: false; clicked => root.set-estimate(90); }
            if root.timer.estimate-minutes > 0 : SmallButton { width: 56px; height: 27px; label: "✎ " + root.timer.estimate-minutes + "m"; clicked => root.custom-estimate(); }
            if root.timer.estimate-minutes > 0 : SmallButton { width: 29px; height: 27px; label: "×"; danger: true; clicked => root.set-estimate(0); }
            if root.timer.estimate-minutes == 0 : SmallButton { width: 38px; height: 27px; label: "…"; clicked => root.custom-estimate(); }
            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 18px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.timer.elapsed;
                    color: #fafafa;
                    font-family: "monospace";
                    font-size: 56px;
                    font-weight: 500;
                    letter-spacing: -1.5px;
                    vertical-alignment: bottom;
                }
                Text {
                    text: root.timer.added;
                    color: root.timer.color;
                    font-family: "monospace";
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            RoundAction {
                width: 46px;
                height: 46px;
                label: root.timer.running ? "Ⅱ" : "▶";
                accent: root.timer.color;
                filled: !root.timer.running;
                clicked => root.toggle();
            }
            RoundAction {
                width: 46px;
                height: 46px;
                label: "✓";
                accent: #a1a1aa;
                clicked => root.save();
            }
        }
    }
}

component TimerTableRow inherits Rectangle {
    in property <TimerRow> timer;
    callback toggle;
    callback save;
    callback discard;
    callback move(int);
    height: 62px;
    background: transparent;
    cache-rendering-hint: true;

    row := Rectangle {
        height: 58px;
        border-radius: 10px;
        background: touch.has-hover ? #202024e8 : #18181bd9;
        border-width: 1px;
        border-color: root.timer.running ? root.timer.color : #ffffff0b;
        animate background { duration: 140ms; easing: ease-out; }
        animate border-color { duration: 180ms; easing: ease-out; }
        touch := TouchArea { }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 8px;
            Rectangle { width: 3px; height: 34px; border-radius: 2px; background: root.timer.color; }
            Text { horizontal-stretch: 1; text: root.timer.name; color: #e4e4e7; font-size: 12px; font-weight: 600; overflow: elide; vertical-alignment: center; }
            Text { width: 96px; text: root.timer.estimate-minutes > 0 ? root.timer.estimate-minutes + " min" : "—"; color: #71717a; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
            Text { width: 124px; text: root.timer.elapsed; color: #fafafa; font-family: "monospace"; font-size: 16px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
            HorizontalLayout {
                width: 178px;
                spacing: 6px;
                SmallButton { width: 26px; height: 34px; label: "↑"; clicked => root.move(-1); }
                SmallButton { width: 26px; height: 34px; label: "↓"; clicked => root.move(1); }
                RoundAction { width: 34px; height: 34px; label: root.timer.running ? "Ⅱ" : "▶"; accent: root.timer.color; filled: !root.timer.running; clicked => root.toggle(); }
                RoundAction { width: 34px; height: 34px; label: "✓"; clicked => root.save(); }
                SmallButton { width: 30px; height: 34px; label: "×"; danger: true; clicked => root.discard(); }
            }
        }
    }
}

component OverlayLayer inherits Rectangle {
    in-out property <bool> onboarding-visible;
    in-out property <int> onboarding-step;
    in-out property <bool> settings-open;
    in-out property <int> settings-tab;
    in-out property <string> settings-nick;
    in-out property <string> settings-frontmatter;
    in-out property <string> settings-estimate-key;
    in-out property <string> settings-time-format;
    in-out property <string> settings-obsidian-vault;
    in-out property <string> settings-stats-fields;
    in-out property <string> settings-language;
    in-out property <string> settings-daily-goal;
    in-out property <string> settings-auto-refresh;
    in-out property <bool> settings-notifications;
    in-out property <string> settings-notification-interval;
    in-out property <bool> settings-limit-enabled;
    in-out property <bool> settings-limit-sound-enabled;
    in-out property <string> settings-limit-sound-path;
    in-out property <bool> settings-limit-notification-enabled;
    in-out property <bool> settings-limit-overlay;
    in-out property <string> settings-limit-message;
    in-out property <string> updater-status;
    in-out property <bool> update-available;
    in-out property <bool> new-note-open;
    in-out property <string> new-note-filename;
    in-out property <string> new-note-time;
    in-out property <string> new-note-tags;
    in-out property <bool> close-guard-open;
    in-out property <bool> preview-open;
    in-out property <string> preview-title;
    in-out property <string> preview-path;
    in-out property <string> preview-body;
    in-out property <bool> edit-note-open;
    in-out property <string> edit-note-title;
    in-out property <string> edit-note-path;
    in-out property <string> edit-note-time;
    in-out property <bool> custom-estimate-open;
    in-out property <int> custom-estimate-index;
    in-out property <string> custom-estimate-value;
    in-out property <bool> expiration-overlay-open;
    in-out property <string> expiration-overlay-title;
    in-out property <string> expiration-overlay-message;
    in property <string> vault-path;
    in property <[ProfileRow]> profiles;
    callback choose-folder;
    callback save-settings;
    callback create-note;
    callback close-save-all;
    callback close-discard-all;
    callback save-note-edit;
    callback save-custom-estimate(int, string);
    callback switch-profile(int);
    callback create-profile;
    callback delete-profile(int);
    callback complete-onboarding;
    callback choose-alert-sound;
    callback check-update;
    callback install-update;
    background: transparent;

    if root.settings-open : Rectangle {
        background: #000000b8;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 610px);
            height: Math.min(parent.height - 40px, 500px);
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    height: 30px;
                    Text { text: I18n.tr(I18n.language, "settings"); color: #fafafa; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                    SmallButton { width: 30px; label: "×"; clicked => { root.settings-open = false; } }
                }
                HorizontalLayout {
                    height: 33px;
                    spacing: 5px;
                    SmallButton { horizontal-stretch: 1; label: I18n.tr(I18n.language, "settings"); active: root.settings-tab == 0; clicked => { root.settings-tab = 0; } }
                    SmallButton { horizontal-stretch: 1; label: I18n.tr(I18n.language, "frontmatterKey"); active: root.settings-tab == 1; clicked => { root.settings-tab = 1; } }
                    SmallButton { horizontal-stretch: 1; label: I18n.tr(I18n.language, "notificationsTabLabel"); active: root.settings-tab == 2; clicked => { root.settings-tab = 2; } }
                    SmallButton { horizontal-stretch: 1; label: I18n.tr(I18n.language, "dailyGoal"); active: root.settings-tab == 3; clicked => { root.settings-tab = 3; } }
                    SmallButton { horizontal-stretch: 1; label: I18n.tr(I18n.language, "vaultProfiles"); active: root.settings-tab == 4; clicked => { root.settings-tab = 4; } }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 11px;
                    background: #111113;
                    border-width: 1px;
                    border-color: #ffffff0a;

                    if root.settings-tab == 0 : VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: I18n.tr(I18n.language, "nick"); color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-nick; placeholder-text: "nick"; }
                        Text { text: I18n.tr(I18n.language, "language"); color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-language; placeholder-text: "cs"; }
                        Text { text: I18n.tr(I18n.language, "autoRefresh"); color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-auto-refresh; placeholder-text: "10"; }
                        Text { text: root.vault-path == "" ? I18n.tr(I18n.language, "notesFolder") : root.vault-path; color: #52525b; font-size: 9px; overflow: elide; }
                        SmallButton { width: 180px; label: I18n.tr(I18n.language, "changeFolder"); clicked => root.choose-folder(); }
                        HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            SmallButton { width: 180px; label: I18n.tr(I18n.language, "checkForUpdates"); clicked => root.check-update(); }
                            if root.update-available : SmallButton { width: 170px; label: I18n.tr(I18n.language, "updateInstall"); active: true; clicked => root.install-update(); }
                        }
                        Text { text: root.updater-status; color: root.update-available ? #34d399 : #52525b; font-size: 9px; overflow: elide; }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.settings-tab == 1 : VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: I18n.tr(I18n.language, "frontmatterTimeKey"); color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-frontmatter; placeholder-text: "Timework"; }
                        Text { text: I18n.tr(I18n.language, "timeEstimateKey"); color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-estimate-key; placeholder-text: "timeEstimate"; }
                        Text { text: I18n.tr(I18n.language, "timeFormat"); color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-time-format; placeholder-text: "HH:mm:ss"; }
                        Text { text: I18n.tr(I18n.language, "obsidianVault"); color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-obsidian-vault; placeholder-text: "odvodí se z názvu složky"; }
                        Text { text: I18n.tr(I18n.language, "frontmatterStatsKey"); color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-stats-fields; placeholder-text: "project, client, type"; }
                        Text { text: I18n.tr(I18n.language, "configDescription"); color: #52525b; font-size: 9px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.settings-tab == 2 : VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: I18n.tr(I18n.language, "timerLimitAlertsSection"); color: #e4e4e7; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            height: 29px;
                            spacing: 6px;
                            SmallButton { horizontal-stretch: 1; label: I18n.tr(I18n.language, "enableAlerts"); active: root.settings-limit-enabled; clicked => { root.settings-limit-enabled = !root.settings-limit-enabled; } }
                            SmallButton { horizontal-stretch: 1; label: I18n.tr(I18n.language, "sendNotification"); active: root.settings-limit-notification-enabled; enabled: root.settings-limit-enabled; clicked => { root.settings-limit-notification-enabled = !root.settings-limit-notification-enabled; } }
                            SmallButton { horizontal-stretch: 1; label: I18n.tr(I18n.language, "showOverlay"); active: root.settings-limit-overlay; enabled: root.settings-limit-enabled; clicked => { root.settings-limit-overlay = !root.settings-limit-overlay; } }
                        }
                        HorizontalLayout {
                            height: 29px;
                            spacing: 6px;
                            SmallButton { width: 130px; label: I18n.tr(I18n.language, "playSound"); active: root.settings-limit-sound-enabled; enabled: root.settings-limit-enabled; clicked => { root.settings-limit-sound-enabled = !root.settings-limit-sound-enabled; } }
                            SmallButton { width: 120px; label: I18n.tr(I18n.language, "selectSoundFile"); enabled: root.settings-limit-enabled && root.settings-limit-sound-enabled; clicked => root.choose-alert-sound(); }
                            Text { text: root.settings-limit-sound-path == "" ? I18n.tr(I18n.language, "noData") : root.settings-limit-sound-path; color: #52525b; font-size: 9px; overflow: elide; vertical-alignment: center; }
                        }
                        Text { text: I18n.tr(I18n.language, "customMessage"); color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-limit-message; placeholder-text: "Časový odhad byl vyčerpán"; }
                        Rectangle { height: 1px; background: #ffffff0d; }
                        Text { text: I18n.tr(I18n.language, "regularAlertsSection"); color: #e4e4e7; font-size: 11px; font-weight: 600; }
                        HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            SmallButton { width: 120px; label: I18n.tr(I18n.language, "enableNotifications"); active: root.settings-notifications; clicked => { root.settings-notifications = !root.settings-notifications; } }
                            LineEdit { text <=> root.settings-notification-interval; placeholder-text: "minuty (0–1440)"; }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.settings-tab == 3 : VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: I18n.tr(I18n.language, "dailyGoal"); color: #a1a1aa; font-size: 10px; }
                        LineEdit { text <=> root.settings-daily-goal; placeholder-text: "8.0"; }
                        Text { text: I18n.tr(I18n.language, "dailyGoal"); color: #52525b; font-size: 9px; }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.settings-tab == 4 : VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: I18n.tr(I18n.language, "activeProfile"); color: #a1a1aa; font-size: 10px; }
                        Text { text: root.vault-path; color: #e4e4e7; font-size: 11px; overflow: elide; }
                        HorizontalLayout {
                            height: 30px;
                            Text { text: I18n.tr(I18n.language, "vaultProfiles"); color: #a1a1aa; font-size: 10px; vertical-alignment: center; }
                            SmallButton { width: 145px; label: I18n.tr(I18n.language, "addProfile"); clicked => root.create-profile(); }
                        }
                        ListView {
                            for profile[index] in root.profiles : Rectangle {
                                height: 38px;
                                border-radius: 7px;
                                background: profile.active ? #16302b : #202024;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    Text { text: profile.nick; color: profile.active ? #6ee7b7 : #d4d4d8; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: profile.active ? I18n.tr(I18n.language, "activeProfile") : ""; color: #34d399; font-size: 8px; vertical-alignment: center; }
                                    SmallButton { width: 72px; height: 27px; label: profile.active ? I18n.tr(I18n.language, "active") : I18n.tr(I18n.language, "switchToProfile"); active: profile.active; clicked => root.switch-profile(index); }
                                    SmallButton { width: 28px; height: 27px; label: "×"; danger: true; clicked => root.delete-profile(index); }
                                }
                            }
                        }
                        SmallButton { width: 180px; label: I18n.tr(I18n.language, "changeFolder"); clicked => root.choose-folder(); }
                    }
                }

                HorizontalLayout {
                    height: 34px;
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { width: 100px; label: I18n.tr(I18n.language, "cancel"); clicked => { root.settings-open = false; } }
                    SmallButton { width: 120px; label: I18n.tr(I18n.language, "save"); active: true; clicked => root.save-settings(); }
                }
            }
        }
    }

    if root.new-note-open : Rectangle {
        background: #000000b8;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 420px);
            height: 340px;
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                HorizontalLayout {
                    height: 30px;
                Text { text: I18n.tr(I18n.language, "new"); color: #fafafa; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                    SmallButton { width: 30px; label: "×"; clicked => { root.new-note-open = false; } }
                }
                Text { text: "Název souboru nebo existující podsložka/soubor.md"; color: #a1a1aa; font-size: 10px; }
                LineEdit { text <=> root.new-note-filename; placeholder-text: "2026-08-31.md"; }
                Text { text: I18n.tr(I18n.language, "totalTime"); color: #a1a1aa; font-size: 10px; }
                LineEdit { text <=> root.new-note-time; placeholder-text: "00:00:00"; }
                Text { text: I18n.tr(I18n.language, "breakdown"); color: #a1a1aa; font-size: 10px; }
                LineEdit { text <=> root.new-note-tags; placeholder-text: "projekt, klient"; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 34px;
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { width: 100px; label: I18n.tr(I18n.language, "cancel"); clicked => { root.new-note-open = false; } }
                    SmallButton { width: 120px; label: I18n.tr(I18n.language, "new"); active: true; clicked => root.create-note(); }
                }
            }
        }
    }

    if root.close-guard-open : Rectangle {
        background: #000000b8;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 440px);
            height: 300px;
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text { text: I18n.tr(I18n.language, "closeGuardTitle"); color: #fafafa; font-size: 18px; font-weight: 700; }
                Text { text: I18n.tr(I18n.language, "closeGuardMessage"); color: #a1a1aa; font-size: 11px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                SmallButton { height: 38px; label: "✓  " + I18n.tr(I18n.language, "closeGuardSaveAndClose"); active: true; clicked => root.close-save-all(); }
                SmallButton { height: 38px; label: I18n.tr(I18n.language, "closeGuardDiscardAndClose"); danger: true; clicked => root.close-discard-all(); }
                SmallButton { height: 34px; label: I18n.tr(I18n.language, "closeGuardCancel"); clicked => { root.close-guard-open = false; } }
            }
        }
    }

    if root.preview-open : Rectangle {
        background: #000000b8;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 540px);
            height: 330px;
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                HorizontalLayout {
                    height: 30px;
                    VerticalLayout {
                        Text { text: root.preview-title; color: #fafafa; font-size: 16px; font-weight: 700; overflow: elide; }
                        Text { text: root.preview-path; color: #52525b; font-size: 9px; overflow: elide; }
                    }
                    SmallButton { width: 30px; label: "×"; clicked => { root.preview-open = false; } }
                }
                Rectangle { height: 1px; background: #ffffff0d; }
                Text { vertical-stretch: 1; text: root.preview-body == "" ? I18n.tr(I18n.language, "noData") : root.preview-body; color: #d4d4d8; font-size: 11px; wrap: word-wrap; }
                SmallButton { width: 100px; label: I18n.tr(I18n.language, "close"); clicked => { root.preview-open = false; } }
            }
        }
    }

    if root.edit-note-open : Rectangle {
        background: #000000b8;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 400px);
            height: 250px;
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    height: 30px;
                    Text { text: I18n.tr(I18n.language, "edit") + " — " + root.edit-note-title; color: #fafafa; font-size: 16px; font-weight: 700; overflow: elide; }
                    SmallButton { width: 30px; label: "×"; clicked => { root.edit-note-open = false; } }
                }
                Text { text: I18n.tr(I18n.language, "totalTime"); color: #a1a1aa; font-size: 10px; }
                LineEdit { text <=> root.edit-note-time; placeholder-text: "00:00:00"; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 34px;
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { width: 100px; label: I18n.tr(I18n.language, "cancel"); clicked => { root.edit-note-open = false; } }
                    SmallButton { width: 110px; label: I18n.tr(I18n.language, "save"); active: true; clicked => root.save-note-edit(); }
                }
            }
        }
    }

    if root.custom-estimate-open : Rectangle {
        background: #000000b8;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 380px);
            height: 230px;
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    height: 30px;
                    Text { text: I18n.tr(I18n.language, "customEstimate"); color: #fafafa; font-size: 16px; font-weight: 700; }
                    SmallButton { width: 30px; label: "×"; clicked => { root.custom-estimate-open = false; } }
                }
                Text { text: I18n.tr(I18n.language, "minutes"); color: #a1a1aa; font-size: 10px; }
                LineEdit { text <=> root.custom-estimate-value; placeholder-text: "120"; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 34px;
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { width: 100px; label: I18n.tr(I18n.language, "cancel"); clicked => { root.custom-estimate-open = false; } }
                    SmallButton { width: 110px; label: I18n.tr(I18n.language, "save"); active: true; clicked => root.save-custom-estimate(root.custom-estimate-index, root.custom-estimate-value); }
                }
            }
        }
    }

    if root.expiration-overlay-open : Rectangle {
        background: #000000c4;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 440px);
            height: 250px;
            border-radius: 18px;
            background: #211316fa;
            border-width: 1px;
            border-color: #fb718566;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: "!"; color: #fb7185; font-size: 30px; font-weight: 700; horizontal-alignment: center; }
                Text { text: root.expiration-overlay-title; color: #fafafa; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                Text { text: root.expiration-overlay-message; color: #d4d4d8; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; }
                Rectangle { vertical-stretch: 1; }
                SmallButton { height: 38px; label: I18n.tr(I18n.language, "close"); active: true; clicked => { root.expiration-overlay-open = false; } }
            }
        }
    }

    if root.onboarding-visible : Rectangle {
        background: #09090bf4;
        AmbientOrb {
            x: parent.width / 2 - 260px;
            y: parent.height / 2 - 260px;
            width: 520px;
            height: 520px;
            glow-color: #10b981;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 40px, 480px);
            height: 390px;
            border-radius: 18px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #10b98144;
            VerticalLayout {
                padding: 28px;
                spacing: 14px;
                Text { text: "mmStopWatch"; color: #fafafa; font-size: 25px; font-weight: 700; horizontal-alignment: center; }
                Text { text: I18n.tr(I18n.language, "welcomeTitle"); color: #a1a1aa; font-size: 11px; horizontal-alignment: center; }
                Text { text: "KROK " + (root.onboarding-step + 1) + " ZE 3"; color: #34d399; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
                Rectangle { height: 1px; background: #ffffff0d; }
                if root.onboarding-step == 0 : VerticalLayout {
                    spacing: 14px;
                    Text { text: I18n.tr(I18n.language, "folderDescription"); color: #71717a; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; }
                    Rectangle { vertical-stretch: 1; }
                    SmallButton { height: 42px; label: I18n.tr(I18n.language, "selectFolder"); active: true; clicked => root.choose-folder(); }
                    Text { text: "Data zůstávají pouze ve vašem vaultu."; color: #52525b; font-size: 9px; horizontal-alignment: center; }
                }
                if root.onboarding-step == 1 : VerticalLayout {
                    spacing: 10px;
                Text { text: I18n.tr(I18n.language, "profileName"); color: #a1a1aa; font-size: 10px; }
                    LineEdit { text <=> root.settings-nick; placeholder-text: "moje-prace"; }
                    Text { text: I18n.tr(I18n.language, "welcomeDescription"); color: #71717a; font-size: 10px; wrap: word-wrap; }
                    Text { text: root.vault-path; color: #52525b; font-size: 9px; overflow: elide; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        height: 36px;
                        SmallButton { width: 90px; label: I18n.tr(I18n.language, "back"); clicked => { root.onboarding-step = 0; } }
                        Rectangle { horizontal-stretch: 1; }
                        SmallButton { width: 120px; label: I18n.tr(I18n.language, "continueStep"); active: true; clicked => { root.onboarding-step = 2; } }
                    }
                }
                if root.onboarding-step == 2 : VerticalLayout {
                    spacing: 8px;
                    Text { text: I18n.tr(I18n.language, "frontmatterTimeKey"); color: #a1a1aa; font-size: 10px; }
                    LineEdit { text <=> root.settings-frontmatter; placeholder-text: "Timework"; }
                    Text { text: I18n.tr(I18n.language, "timeEstimateKey"); color: #a1a1aa; font-size: 10px; }
                    LineEdit { text <=> root.settings-estimate-key; placeholder-text: "timeEstimate"; }
                    Text { text: I18n.tr(I18n.language, "dailyGoal"); color: #a1a1aa; font-size: 10px; }
                    LineEdit { text <=> root.settings-daily-goal; placeholder-text: "8.0"; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        height: 36px;
                        SmallButton { width: 90px; label: I18n.tr(I18n.language, "back"); clicked => { root.onboarding-step = 1; } }
                        Rectangle { horizontal-stretch: 1; }
                        SmallButton { width: 150px; label: I18n.tr(I18n.language, "finish"); active: true; clicked => root.complete-onboarding(); }
                    }
                }
            }
        }
    }
}

component NoteCard inherits Rectangle {
    in property <NoteRow> note;
    in property <bool> scrolling: false;
    callback open;
    callback pin;
    callback preview;
    callback edit;
    callback obsidian;
    height: 98px;
    background: transparent;
    cache-rendering-hint: true;

    card := Rectangle {
        width: parent.width;
        height: 90px;
        border-radius: 12px;
        background: !root.scrolling && touch.has-hover ? #29292ed9 : root.note.active ? #202327f0 : root.note.pinned ? #202024e8 : #18181bd9;
        border-width: 1px;
        border-color: root.note.active ? root.note.accent : root.note.pinned ? #6366f166 : #ffffff0d;
        clip: true;
        animate background { duration: 150ms; easing: ease-out; }
        animate border-color { duration: 180ms; easing: ease-out; }

        touch := TouchArea { clicked => root.open(); }
        VerticalLayout {
            padding-left: 13px;
            padding-right: 10px;
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: 5px;
            HorizontalLayout {
                height: 16px;
                Text { text: root.note.relative-path; color: #71717a; font-size: 10px; overflow: elide; vertical-alignment: center; }
                SmallButton { width: 25px; height: 20px; label: root.note.pinned ? "◆" : "◇"; active: root.note.pinned; clicked => root.pin(); }
            }
            HorizontalLayout {
                height: 21px;
                spacing: 8px;
                Text { text: root.note.name; color: #f4f4f5; font-size: 14px; font-weight: 500; overflow: elide; vertical-alignment: center; }
                Text { width: 88px; text: root.note.active ? "▶  " + root.note.duration : root.note.duration; color: root.note.active ? root.note.accent : #d4d4d8; font-size: 12px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
            }
            HorizontalLayout {
                height: 24px;
                spacing: 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 22px;
                    border-radius: 5px;
                    background: root.note.tags == "" ? transparent : #27272acc;
                    border-width: root.note.tags == "" ? 0px : 1px;
                    border-color: #ffffff0a;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        text: root.note.tags;
                        color: #a1a1aa;
                        font-size: 9px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                SmallButton { width: 26px; height: 23px; label: "✎"; clicked => root.edit(); }
                SmallButton { width: 26px; height: 23px; label: "◉"; clicked => root.preview(); }
                SmallButton { width: 26px; height: 23px; label: "↗"; clicked => root.obsidian(); }
            }
        }
    }
}

component StatsCalendarCell inherits Rectangle {
    in property <StatsCalendarDayRow> day;
    border-radius: 7px;
    background: !root.day.in-month ? transparent
        : root.day.today ? #1d4ed855
        : root.day.goal-met ? #065f4666
        : root.day.progress >= 0.5 ? #07598555
        : root.day.progress > 0 ? #1e3a5f55
        : #202024;
    border-width: root.day.today ? 1px : 0px;
    border-color: #60a5fa;
    opacity: root.day.in-month ? 1 : 0.25;
    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        Text { text: root.day.day; color: root.day.today ? #93c5fd : #d4d4d8; font-size: 10px; font-weight: root.day.today ? 700 : 500; }
        Text { text: root.day.duration; color: root.day.goal-met ? #34d399 : #71717a; font-size: 8px; overflow: elide; }
    }
}

component StatsTrendBar inherits Rectangle {
    in property <StatsTrendRow> trend;
    height: 34px;
    border-radius: 7px;
    background: #18181b;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 7px;
        Text { width: 38px; text: root.trend.label; color: #a1a1aa; font-size: 9px; vertical-alignment: center; }
        Rectangle {
            horizontal-stretch: 1;
            height: 5px;
            border-radius: 3px;
            background: #3f3f46;
            Rectangle { width: parent.width * root.trend.progress; height: parent.height; border-radius: 3px; background: #38bdf8; }
        }
        Text { width: 66px; text: root.trend.duration; color: #d4d4d8; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

export component AppWindow inherits Window {
    in property <string> app-version: "dev";
    title: "mmStopWatch Native v" + app-version;
    in-out property <length> preview-width: 900px;
    in-out property <length> preview-height: 600px;
    preferred-width: root.preview-width;
    preferred-height: root.preview-height;
    min-width: 360px;
    min-height: 500px;
    background: #09090b;

    in property <[NoteRow]> notes;
    in property <[TimerRow]> timers;
    in property <[TimerGridRow]> timer-grid;
    in-out property <string> vault-path;
    in property <string> status-message: "Vyberte složku s Markdown poznámkami.";
    in property <bool> status-error: false;
    in property <int> timer-count: 0;
    in-out property <bool> table-view: false;
    in-out property <int> layout-columns: 1;
    property <length> viewport-width: 900px;
    in property <bool> force-compact: false;
    property <bool> compact: root.viewport-width < 760px || root.force-compact;
    in-out property <bool> sidebar-open: false;
    in property <int> note-count: 0;
    in property <int> notes-loaded: 0;
    in property <int> filtered-note-count: 0;
    in property <bool> has-more-notes: false;
    in property <bool> notes-loading: false;
    in-out property <length> notes-scroll-y: 0px;
    in-out property <bool> sidebar-scrolling: false;
    in property <string> scan-warning: "";
    in property <string> total-duration: "00:00:00";
    in-out property <bool> onboarding-visible: false;
    in-out property <int> onboarding-step: 0;
    in-out property <bool> settings-open: false;
    in-out property <int> settings-tab: 0;
    in-out property <string> settings-nick: "";
    in-out property <string> settings-frontmatter: "Timework";
    in-out property <string> settings-estimate-key: "timeEstimate";
    in-out property <string> settings-time-format: "HH:mm:ss";
    in-out property <string> settings-obsidian-vault: "";
    in-out property <string> settings-stats-fields: "project, client, type";
    in-out property <string> settings-language: "cs";
    in-out property <string> settings-daily-goal: "8.0";
    in-out property <string> settings-auto-refresh: "10";
    in-out property <bool> settings-notifications: true;
    in-out property <string> settings-notification-interval: "60";
    in-out property <bool> settings-limit-enabled: true;
    in-out property <bool> settings-limit-sound-enabled: false;
    in-out property <string> settings-limit-sound-path: "";
    in-out property <bool> settings-limit-notification-enabled: true;
    in-out property <bool> settings-limit-overlay: true;
    in-out property <string> settings-limit-message: "";
    in-out property <string> updater-status: "";
    in-out property <bool> update-available: false;
    in-out property <string> update-download-url: "";
    in-out property <bool> new-note-open: false;
    in-out property <string> new-note-filename: "";
    in-out property <string> new-note-time: "";
    in-out property <string> new-note-tags: "";
    in-out property <bool> close-guard-open: false;
    in-out property <bool> preview-open: false;
    in-out property <string> preview-title: "";
    in-out property <string> preview-path: "";
    in-out property <string> preview-body: "";
    in-out property <bool> edit-note-open: false;
    in-out property <string> edit-note-title: "";
    in-out property <string> edit-note-path: "";
    in-out property <string> edit-note-time: "";
    in-out property <bool> custom-estimate-open: false;
    in-out property <int> custom-estimate-index: -1;
    in-out property <string> custom-estimate-value: "";
    in-out property <bool> expiration-overlay-open: false;
    in-out property <string> expiration-overlay-title: "";
    in-out property <string> expiration-overlay-message: "";
    in-out property <bool> stats-open: false;
    in property <string> stats-total: "00:00:00";
    in property <string> stats-today: "00:00:00";
    in property <string> stats-week: "00:00:00";
    in property <string> stats-month: "00:00:00";
    in property <string> stats-average: "00:00:00";
    in property <string> stats-longest: "00:00:00";
    in property <int> stats-count: 0;
    in property <float> goal-progress: 0;
    in property <int> stats-streak: 0;
    in property <int> stats-consistency: 0;
    in property <int> stats-weekly-delta: 0;
    in property <[StatsRow]> stats-notes;
    in property <[StatsRow]> stats-breakdown;
    in property <int> stats-breakdown-count: 0;
    in property <[StatsDayRow]> stats-days;
    in property <string> stats-calendar-month: "";
    in property <[StatsCalendarWeekRow]> stats-calendar;
    in property <[StatsTrendRow]> stats-weekdays;
    in property <[StatsTrendRow]> stats-hours;
    in property <string> stats-best-weekday: "—";
    in property <string> stats-peak-hour: "—";
    in property <string> stats-weekday-average: "00:00:00";
    in property <string> stats-weekend-average: "00:00:00";
    in property <int> stats-night-percent: 0;
    in property <string> stats-productivity: "→ stabilní";
    in property <int> stats-productivity-direction: 0;
    in-out property <int> stats-tab: 0;
    in property <string> stats-profile-name: "—";
    in property <int> stats-profile-index: 0;
    in property <int> stats-profile-count: 1;
    in property <bool> stats-profile-active: true;
    in property <[ProfileRow]> profiles;
    in property <float> glow-a-x: 18;
    in property <float> glow-a-y: 24;
    in property <float> glow-b-x: 48;
    in property <float> glow-b-y: 66;
    property <bool> selected-layout-feasible: root.layout-columns == 1
        || (root.layout-columns == 2 && root.viewport-width >= 1086px)
        || (root.layout-columns == 3 && root.viewport-width >= 1461px)
        || (root.layout-columns == 4 && root.viewport-width >= 1836px);

    changed width => {
        root.viewport-width = root.width;
    }

    callback choose-folder;
    callback refresh;
    callback search-changed(string);
    callback add-timer(int);
    callback toggle-timer(int);
    callback save-timer(int);
    callback discard-timer(int);
    callback set-timer-estimate(int, int);
    callback save-custom-estimate(int, string);
    callback move-timer(int, int);
    callback sort-timers(int);
    callback set-timer-view(bool);
    callback set-layout-columns(int);
    callback toggle-pin(int);
    callback preview-note(int);
    callback edit-note(int);
    callback open-obsidian(int);
    callback open-stats;
    callback shift-stats-profile(int);
    callback shift-stats-calendar(int);
    callback export-report(bool);
    callback open-settings;
    callback save-settings;
    callback create-note;
    callback close-save-all;
    callback close-discard-all;
    callback save-note-edit;
    callback switch-profile(int);
    callback create-profile;
    callback delete-profile(int);
    callback complete-onboarding;
    callback choose-alert-sound;
    callback check-update;
    callback install-update;
    callback load-more-notes;
    callback sidebar-scrolled;

    HorizontalLayout {
        spacing: 0px;

        if !root.compact || !root.sidebar-open : Rectangle {
            horizontal-stretch: 1;
            background: #09090b88;
            clip: true;

            for row in 10 : Rectangle {
                background: transparent;
                for column in 14 : Rectangle {
                    x: column * 58px + 22px;
                    y: row * 58px + 22px;
                    width: 1px;
                    height: 1px;
                    border-radius: 1px;
                    background: #ffffff;
                    opacity: 0.045;
                }
            }

            AmbientOrb {
                x: parent.width * root.glow-a-x / 100 - 230px;
                y: parent.height * root.glow-a-y / 100 - 230px;
                width: 460px;
                height: 460px;
                glow-color: #0ea5e9;
            }
            AmbientOrb {
                x: parent.width * root.glow-b-x / 100 - 260px;
                y: parent.height * root.glow-b-y / 100 - 260px;
                width: 520px;
                height: 520px;
                glow-color: #8b5cf6;
            }

            VerticalLayout {
                padding: 24px;
                spacing: 10px;

                HorizontalLayout {
                    height: 30px;
                    spacing: 5px;
                    Rectangle { horizontal-stretch: 1; }
                    if root.compact : SmallButton { width: 94px; label: I18n.tr(I18n.language, "noteBreakdown") + " " + root.note-count; active: root.sidebar-open; clicked => { root.sidebar-open = true; } }
                    SmallButton { width: 31px; label: "☷"; active: !root.table-view; clicked => root.set-timer-view(false); }
                    SmallButton { width: 31px; label: "▦"; enabled: !root.compact; active: root.table-view && !root.compact; clicked => root.set-timer-view(true); }
                    SmallButton { width: 31px; label: "1"; active: root.layout-columns == 1 || !root.selected-layout-feasible; clicked => root.set-layout-columns(1); }
                    SmallButton { width: 31px; label: "2"; enabled: root.viewport-width >= 1086px; active: root.layout-columns == 2 && root.selected-layout-feasible; clicked => root.set-layout-columns(2); }
                    SmallButton { width: 31px; label: "3"; enabled: root.viewport-width >= 1461px; active: root.layout-columns == 3 && root.selected-layout-feasible; clicked => root.set-layout-columns(3); }
                    SmallButton { width: 31px; label: "4"; enabled: root.viewport-width >= 1836px; active: root.layout-columns == 4 && root.selected-layout-feasible; clicked => root.set-layout-columns(4); }
                }

                if root.timer-count == 0 : Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                    VerticalLayout {
                        alignment: center;
                        spacing: 9px;
                        Text { text: "00:00:00.00"; color: #27272a; font-size: 37px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: I18n.tr(I18n.language, "start"); color: #52525b; font-size: 11px; horizontal-alignment: center; }
                    }
                }

                if root.timer-count > 0 && (!root.table-view || root.compact) && (root.layout-columns == 1 || !root.selected-layout-feasible || root.compact) : ListView {
                    vertical-stretch: 1;
                    for timer[index] in root.timers : TimerCard {
                        timer: timer;
                        row-index: index;
                        toggle => root.toggle-timer(index);
                        save => root.save-timer(index);
                        discard => root.discard-timer(index);
                        set-estimate(minutes) => root.set-timer-estimate(index, minutes);
                        custom-estimate => { root.custom-estimate-index = index; root.custom-estimate-value = timer.estimate-minutes > 0 ? timer.estimate-minutes : ""; root.custom-estimate-open = true; }
                        move(offset) => root.move-timer(index, offset);
                    }
                }

                if root.timer-count > 0 && !root.table-view && !root.compact && root.layout-columns > 1 && root.selected-layout-feasible : ListView {
                    vertical-stretch: 1;
                    for group[row-index] in root.timer-grid : HorizontalLayout {
                        height: 252px;
                        spacing: 16px;
                        if group.has-a : TimerCard { timer: group.a; row-index: row-index * root.layout-columns; toggle => root.toggle-timer(row-index * root.layout-columns); save => root.save-timer(row-index * root.layout-columns); discard => root.discard-timer(row-index * root.layout-columns); set-estimate(minutes) => root.set-timer-estimate(row-index * root.layout-columns, minutes); custom-estimate => { root.custom-estimate-index = row-index * root.layout-columns; root.custom-estimate-value = group.a.estimate-minutes > 0 ? group.a.estimate-minutes : ""; root.custom-estimate-open = true; } move(offset) => root.move-timer(row-index * root.layout-columns, offset); }
                        if !group.has-a : Rectangle { background: transparent; }
                        if group.has-b : TimerCard { timer: group.b; row-index: row-index * root.layout-columns + 1; toggle => root.toggle-timer(row-index * root.layout-columns + 1); save => root.save-timer(row-index * root.layout-columns + 1); discard => root.discard-timer(row-index * root.layout-columns + 1); set-estimate(minutes) => root.set-timer-estimate(row-index * root.layout-columns + 1, minutes); custom-estimate => { root.custom-estimate-index = row-index * root.layout-columns + 1; root.custom-estimate-value = group.b.estimate-minutes > 0 ? group.b.estimate-minutes : ""; root.custom-estimate-open = true; } move(offset) => root.move-timer(row-index * root.layout-columns + 1, offset); }
                        if !group.has-b : Rectangle { background: transparent; }
                        if root.layout-columns > 2 && group.has-c : TimerCard { timer: group.c; row-index: row-index * root.layout-columns + 2; toggle => root.toggle-timer(row-index * root.layout-columns + 2); save => root.save-timer(row-index * root.layout-columns + 2); discard => root.discard-timer(row-index * root.layout-columns + 2); set-estimate(minutes) => root.set-timer-estimate(row-index * root.layout-columns + 2, minutes); custom-estimate => { root.custom-estimate-index = row-index * root.layout-columns + 2; root.custom-estimate-value = group.c.estimate-minutes > 0 ? group.c.estimate-minutes : ""; root.custom-estimate-open = true; } move(offset) => root.move-timer(row-index * root.layout-columns + 2, offset); }
                        if root.layout-columns > 2 && !group.has-c : Rectangle { background: transparent; }
                        if root.layout-columns > 3 && group.has-d : TimerCard { timer: group.d; row-index: row-index * root.layout-columns + 3; toggle => root.toggle-timer(row-index * root.layout-columns + 3); save => root.save-timer(row-index * root.layout-columns + 3); discard => root.discard-timer(row-index * root.layout-columns + 3); set-estimate(minutes) => root.set-timer-estimate(row-index * root.layout-columns + 3, minutes); custom-estimate => { root.custom-estimate-index = row-index * root.layout-columns + 3; root.custom-estimate-value = group.d.estimate-minutes > 0 ? group.d.estimate-minutes : ""; root.custom-estimate-open = true; } move(offset) => root.move-timer(row-index * root.layout-columns + 3, offset); }
                        if root.layout-columns > 3 && !group.has-d : Rectangle { background: transparent; }
                    }
                }

                if root.timer-count > 0 && root.table-view && !root.compact : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 5px;
                    HorizontalLayout {
                        height: 28px;
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle { width: 3px; background: transparent; }
                        SmallButton { horizontal-stretch: 1; label: I18n.tr(I18n.language, "profileName") + " ↕"; clicked => root.sort-timers(0); }
                        SmallButton { width: 96px; label: I18n.tr(I18n.language, "setEstimate") + " ↕"; clicked => root.sort-timers(1); }
                        SmallButton { width: 124px; label: I18n.tr(I18n.language, "totalTime") + " ↕"; clicked => root.sort-timers(2); }
                        SmallButton { width: 178px; label: I18n.tr(I18n.language, "active") + " ↕"; clicked => root.sort-timers(3); }
                    }
                    ListView {
                        for timer[index] in root.timers : TimerTableRow {
                            timer: timer;
                            toggle => root.toggle-timer(index);
                            save => root.save-timer(index);
                            discard => root.discard-timer(index);
                            move(offset) => root.move-timer(index, offset);
                        }
                    }
                }

                if root.status-message != "" : Text {
                    height: 18px;
                    text: root.status-message;
                    color: root.status-error ? #fb7185 : #52525b;
                    font-size: 9px;
                    overflow: elide;
                }

            }
        }

        if !root.compact || root.sidebar-open : Rectangle {
            horizontal-stretch: root.compact ? 1 : 0;
            min-width: root.compact ? 0px : 316px;
            max-width: root.compact ? 10000px : 400px;
            preferred-width: 316px;
            background: #0c0c0fee;
            border-width: 1px;
            border-color: #ffffff0d;

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Rectangle {
                    height: 40px;
                    border-radius: 12px;
                    background: #18181bd9;
                    border-width: 1px;
                    border-color: #ffffff09;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                        Text { text: I18n.tr(I18n.language, "totalTime"); color: #52525b; font-size: 8px; font-weight: 700; }
                            Text { text: root.total-duration; color: #e4e4e7; font-size: 14px; font-weight: 700; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                        Text { text: I18n.tr(I18n.language, "noteBreakdown"); color: #52525b; font-size: 8px; font-weight: 700; horizontal-alignment: right; }
                            Text { text: root.note-count; color: #a1a1aa; font-size: 13px; font-weight: 600; horizontal-alignment: right; }
                        }
                    }
                }

                HorizontalLayout {
                    height: 32px;
                    spacing: 5px;
                    if root.compact : SmallButton { width: 70px; label: "‹ " + I18n.tr(I18n.language, "activeTimers"); clicked => { root.sidebar-open = false; } }
                    SmallButton { horizontal-stretch: 1; label: "+ " + I18n.tr(I18n.language, "new"); clicked => { root.new-note-open = true; } }
                    SmallButton { width: 34px; label: "↻"; clicked => root.refresh(); }
                    SmallButton { width: 34px; label: "▥"; clicked => root.open-stats(); }
                    SmallButton { width: 34px; label: "⚙"; clicked => root.open-settings(); }
                }

                LineEdit {
                    height: 34px;
                    placeholder-text: I18n.tr(I18n.language, "filter");
                    edited => root.search-changed(self.text);
                }

                Text {
                    height: 12px;
                    text: root.vault-path == "" ? I18n.tr(I18n.language, "notesFolder") : root.vault-path;
                    color: #3f3f46;
                    font-size: 8px;
                    overflow: elide;
                }

                Text {
                    height: 13px;
                    text: root.notes-loading ? "Obnovuji index na pozadí…"
                        : root.filtered-note-count > root.notes-loaded
                        ? "Zobrazeno " + root.notes-loaded + " z " + root.filtered-note-count + " · rychlý index"
                        : root.filtered-note-count + " poznámek · index připraven";
                    color: root.notes-loading ? #38bdf8 : #52525b;
                    font-size: 9px;
                    overflow: elide;
                }

                if root.scan-warning != "" : Text {
                    height: 24px;
                    text: root.scan-warning;
                    color: #fbbf24;
                    font-size: 8px;
                    wrap: word-wrap;
                }

                if root.notes.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                    Text {
                        text: root.vault-path == "" ? I18n.tr(I18n.language, "selectFolder") : I18n.tr(I18n.language, "noData");
                        color: #52525b;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.notes.length > 0 : notes-list := ListView {
                    viewport-y <=> root.notes-scroll-y;
                    scrolled => {
                        root.sidebar-scrolled();
                        if root.has-more-notes && -notes-list.viewport-y + notes-list.visible-height >= notes-list.viewport-height - 420px {
                            root.load-more-notes();
                        }
                    }
                    for note[index] in root.notes : NoteCard {
                        note: note;
                        scrolling: root.sidebar-scrolling;
                        open => root.add-timer(index);
                        pin => root.toggle-pin(index);
                        preview => root.preview-note(index);
                        edit => root.edit-note(index);
                        obsidian => root.open-obsidian(index);
                    }
                }
            }
        }
    }

    if root.stats-open : Rectangle {
        background: #000000b8;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 24px, 720px);
            height: Math.min(parent.height - 24px, 560px);
            border-radius: 16px;
            background: #18181bf8;
            border-width: 1px;
            border-color: #ffffff12;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                HorizontalLayout {
                    height: 30px;
                    Text { text: I18n.tr(I18n.language, "statistics"); color: #fafafa; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                    SmallButton { width: 30px; label: "×"; clicked => { root.stats-open = false; } }
                }

                Rectangle {
                    height: 38px;
                    border-radius: 9px;
                    background: #202024;
                    border-width: 1px;
                    border-color: root.stats-profile-active ? #34d39955 : #ffffff0d;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        Text { width: 48px; text: I18n.tr(I18n.language, "profileName"); color: #71717a; font-size: 9px; vertical-alignment: center; }
                        SmallButton { width: 28px; height: 26px; label: "‹"; enabled: root.stats-profile-index > 0; clicked => root.shift-stats-profile(-1); }
                        Text { text: root.stats-profile-name; color: #f4f4f5; font-size: 12px; font-weight: 650; overflow: elide; vertical-alignment: center; }
                        if root.stats-profile-active : Rectangle {
                            width: 52px;
                            height: 20px;
                            border-radius: 10px;
                            background: #064e3b99;
                            Text { text: I18n.tr(I18n.language, "active"); color: #6ee7b7; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { width: 34px; text: (root.stats-profile-index + 1) + "/" + root.stats-profile-count; color: #71717a; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                        SmallButton { width: 28px; height: 26px; label: "›"; enabled: root.stats-profile-index + 1 < root.stats-profile-count; clicked => root.shift-stats-profile(1); }
                    }
                }

                if !root.compact : HorizontalLayout {
                    height: 28px;
                    spacing: 5px;
                    SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "perNote"); active: root.stats-tab == 0; clicked => { root.stats-tab = 0; } }
                    SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "allDays"); active: root.stats-tab == 1; clicked => { root.stats-tab = 1; } }
                    SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "calendar"); active: root.stats-tab == 2; clicked => { root.stats-tab = 2; } }
                    SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "trends"); active: root.stats-tab == 3; clicked => { root.stats-tab = 3; } }
                    SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "correlationsAndInsights"); active: root.stats-tab == 4; clicked => { root.stats-tab = 4; } }
                    SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "breakdown"); active: root.stats-tab == 5; clicked => { root.stats-tab = 5; } }
                }

                if root.compact : VerticalLayout {
                    height: 61px;
                    spacing: 5px;
                    HorizontalLayout {
                        height: 28px;
                        spacing: 5px;
                        SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "perNote"); active: root.stats-tab == 0; clicked => { root.stats-tab = 0; } }
                        SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "allDays"); active: root.stats-tab == 1; clicked => { root.stats-tab = 1; } }
                        SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "calendar"); active: root.stats-tab == 2; clicked => { root.stats-tab = 2; } }
                    }
                    HorizontalLayout {
                        height: 28px;
                        spacing: 5px;
                        SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "trends"); active: root.stats-tab == 3; clicked => { root.stats-tab = 3; } }
                        SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "correlationsAndInsights"); active: root.stats-tab == 4; clicked => { root.stats-tab = 4; } }
                        SmallButton { horizontal-stretch: 1; height: 28px; label: I18n.tr(I18n.language, "breakdown"); active: root.stats-tab == 5; clicked => { root.stats-tab = 5; } }
                    }
                }

                if root.stats-tab < 2 : HorizontalLayout {
                    height: 72px;
                    spacing: 8px;
                    Rectangle {
                        border-radius: 10px; background: #202024;
                        VerticalLayout { padding: 10px; spacing: 3px; Text { text: I18n.tr(I18n.language, "today"); color: #71717a; font-size: 9px; } Text { text: root.stats-today; color: #34d399; font-size: 16px; font-weight: 700; } }
                    }
                    Rectangle {
                        border-radius: 10px; background: #202024;
                        VerticalLayout { padding: 10px; spacing: 3px; Text { text: I18n.tr(I18n.language, "thisWeek"); color: #71717a; font-size: 9px; } Text { text: root.stats-week; color: #38bdf8; font-size: 16px; font-weight: 700; } }
                    }
                    Rectangle {
                        border-radius: 10px; background: #202024;
                        VerticalLayout { padding: 10px; spacing: 3px; Text { text: I18n.tr(I18n.language, "thisMonth"); color: #71717a; font-size: 9px; } Text { text: root.stats-month; color: #a78bfa; font-size: 16px; font-weight: 700; } }
                    }
                }

                if root.stats-tab < 2 : Rectangle {
                    height: 44px;
                    border-radius: 10px;
                    background: #202024;
                    VerticalLayout {
                        padding: 9px;
                        spacing: 5px;
                        HorizontalLayout {
                            Text { text: I18n.tr(I18n.language, "dailyGoal"); color: #a1a1aa; font-size: 10px; }
                            Text { text: Math.round(root.goal-progress * 100) + "%"; color: #34d399; font-size: 10px; font-weight: 700; horizontal-alignment: right; }
                        }
                        Rectangle { height: 4px; border-radius: 2px; background: #3f3f46; Rectangle { width: parent.width * root.goal-progress; height: parent.height; border-radius: 2px; background: #10b981; } }
                    }
                }

                if root.stats-tab < 2 : HorizontalLayout {
                    height: 48px;
                    spacing: 8px;
                    Rectangle {
                        border-radius: 9px; background: #202024;
                        VerticalLayout { padding: 8px; spacing: 2px; Text { text: I18n.tr(I18n.language, "streak"); color: #71717a; font-size: 8px; } Text { text: root.stats-streak + " " + I18n.tr(I18n.language, "streakDays"); color: #fbbf24; font-size: 13px; font-weight: 700; } }
                    }
                    Rectangle {
                        border-radius: 9px; background: #202024;
                        VerticalLayout { padding: 8px; spacing: 2px; Text { text: I18n.tr(I18n.language, "consistency"); color: #71717a; font-size: 8px; } Text { text: root.stats-consistency + "%"; color: #34d399; font-size: 13px; font-weight: 700; } }
                    }
                    Rectangle {
                        border-radius: 9px; background: #202024;
                        VerticalLayout { padding: 8px; spacing: 2px; Text { text: I18n.tr(I18n.language, "trend"); color: #71717a; font-size: 8px; } Text { text: (root.stats-weekly-delta > 0 ? "+" : "") + root.stats-weekly-delta + "%"; color: root.stats-weekly-delta >= 0 ? #38bdf8 : #fb7185; font-size: 13px; font-weight: 700; } }
                    }
                }

                if root.stats-tab < 2 : HorizontalLayout {
                    height: 30px;
                    spacing: 14px;
                    Text { text: root.stats-count + " " + I18n.tr(I18n.language, "entries"); color: #a1a1aa; font-size: 11px; vertical-alignment: center; }
                    Text { text: I18n.tr(I18n.language, "total") + " " + root.stats-total; color: #a1a1aa; font-size: 11px; vertical-alignment: center; }
                    Text { text: I18n.tr(I18n.language, "average") + " " + root.stats-average; color: #71717a; font-size: 10px; vertical-alignment: center; }
                    Text { text: I18n.tr(I18n.language, "longest") + " " + root.stats-longest; color: #71717a; font-size: 10px; vertical-alignment: center; }
                }

                if root.stats-tab == 0 && root.stats-count > 0 : ListView {
                    for item in root.stats-notes : Rectangle {
                        height: 42px;
                        background: transparent;
                        Rectangle {
                            height: 38px;
                            border-radius: 7px;
                            background: #202024;
                            border-width: 1px;
                            border-color: #ffffff08;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text { text: item.name; color: #d4d4d8; font-size: 11px; overflow: elide; vertical-alignment: center; }
                                Text { text: item.count + "×"; color: #71717a; font-size: 10px; vertical-alignment: center; }
                                Text { text: item.duration; color: #34d399; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if root.stats-tab == 0 && root.stats-count == 0 : Text {
                    text: I18n.tr(I18n.language, "noData");
                    color: #52525b;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.stats-tab == 1 : ListView {
                    for day in root.stats-days : Rectangle {
                        height: 42px;
                        background: transparent;
                        Rectangle {
                            height: 38px;
                            border-radius: 7px;
                            background: #202024;
                            border-width: 1px;
                            border-color: #ffffff08;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 9px;
                                Text { width: 58px; text: day.date; color: #a1a1aa; font-size: 10px; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 5px;
                                    border-radius: 3px;
                                    background: #3f3f46;
                                    Rectangle { width: parent.width * day.progress; height: parent.height; border-radius: 3px; background: day.goal-met ? #10b981 : #38bdf8; }
                                }
                                Text { width: 72px; text: day.duration; color: day.goal-met ? #34d399 : #d4d4d8; font-size: 10px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 16px; text: day.goal-met ? "✓" : ""; color: #34d399; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if root.stats-tab == 5 && root.stats-breakdown-count > 0 : ListView {
                    for item in root.stats-breakdown : Rectangle {
                        height: 44px;
                        background: transparent;
                        Rectangle {
                            height: 40px;
                            border-radius: 7px;
                            background: #202024;
                            border-width: 1px;
                            border-color: #ffffff08;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text { text: item.name; color: #d4d4d8; font-size: 11px; overflow: elide; vertical-alignment: center; }
                                Text { text: item.count + "×"; color: #71717a; font-size: 10px; vertical-alignment: center; }
                                Text { text: item.duration; color: #a78bfa; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if root.stats-tab == 5 && root.stats-breakdown-count == 0 : Text {
                    text: I18n.tr(I18n.language, "noData");
                    color: #52525b;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.stats-tab == 2 : VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        height: 26px;
                        SmallButton { width: 30px; height: 26px; label: "‹"; clicked => root.shift-stats-calendar(-1); }
                        Text { text: root.stats-calendar-month; color: #e4e4e7; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        SmallButton { width: 30px; height: 26px; label: "›"; clicked => root.shift-stats-calendar(1); }
                    }
                    HorizontalLayout {
                        height: 18px;
                        for label in ["PO", "ÚT", "ST", "ČT", "PÁ", "SO", "NE"] : Text { text: label; color: #71717a; font-size: 8px; font-weight: 700; horizontal-alignment: center; }
                    }
                    ListView {
                        for week in root.stats-calendar : HorizontalLayout {
                            height: 44px;
                            spacing: 4px;
                            StatsCalendarCell { day: week.monday; }
                            StatsCalendarCell { day: week.tuesday; }
                            StatsCalendarCell { day: week.wednesday; }
                            StatsCalendarCell { day: week.thursday; }
                            StatsCalendarCell { day: week.friday; }
                            StatsCalendarCell { day: week.saturday; }
                            StatsCalendarCell { day: week.sunday; }
                        }
                    }
                }
                if root.stats-tab == 3 : HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        border-radius: 10px;
                        background: #202024;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text { height: 20px; text: I18n.tr(I18n.language, "dayOfWeekBreakdown"); color: #71717a; font-size: 9px; font-weight: 700; }
                            ListView { for row in root.stats-weekdays : StatsTrendBar { trend: row; } }
                        }
                    }
                    Rectangle {
                        border-radius: 10px;
                        background: #202024;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text { height: 20px; text: I18n.tr(I18n.language, "hourlyDistribution"); color: #71717a; font-size: 9px; font-weight: 700; }
                            ListView { for row in root.stats-hours : StatsTrendBar { trend: row; } }
                        }
                    }
                }
                if root.stats-tab == 4 : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { border-radius: 10px; background: #202024; VerticalLayout { padding: 12px; spacing: 5px; Text { text: I18n.tr(I18n.language, "bestDay"); color: #71717a; font-size: 9px; font-weight: 700; } Text { text: root.stats-best-weekday; color: #34d399; font-size: 22px; font-weight: 700; } } }
                        Rectangle { border-radius: 10px; background: #202024; VerticalLayout { padding: 12px; spacing: 5px; Text { text: I18n.tr(I18n.language, "hourlyDistribution"); color: #71717a; font-size: 9px; font-weight: 700; } Text { text: root.stats-peak-hour; color: #38bdf8; font-size: 22px; font-weight: 700; } } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { border-radius: 10px; background: #202024; VerticalLayout { padding: 12px; spacing: 5px; Text { text: I18n.tr(I18n.language, "weekdays"); color: #71717a; font-size: 9px; font-weight: 700; } Text { text: root.stats-weekday-average; color: #e4e4e7; font-size: 17px; font-weight: 700; } } }
                        Rectangle { border-radius: 10px; background: #202024; VerticalLayout { padding: 12px; spacing: 5px; Text { text: I18n.tr(I18n.language, "weekend"); color: #71717a; font-size: 9px; font-weight: 700; } Text { text: root.stats-weekend-average; color: #e4e4e7; font-size: 17px; font-weight: 700; } } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { border-radius: 10px; background: #202024; VerticalLayout { padding: 12px; spacing: 5px; Text { text: I18n.tr(I18n.language, "nightWork"); color: #71717a; font-size: 9px; font-weight: 700; } Text { text: root.stats-night-percent + "%"; color: #a78bfa; font-size: 22px; font-weight: 700; } } }
                        Rectangle { border-radius: 10px; background: #202024; VerticalLayout { padding: 12px; spacing: 5px; Text { text: I18n.tr(I18n.language, "productivityTrend"); color: #71717a; font-size: 9px; font-weight: 700; } Text { text: root.stats-productivity; color: root.stats-productivity-direction > 0 ? #34d399 : root.stats-productivity-direction < 0 ? #fb7185 : #a1a1aa; font-size: 15px; font-weight: 700; } } }
                    }
                }
                HorizontalLayout {
                    height: 32px;
                    spacing: 6px;
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { width: 142px; label: I18n.tr(I18n.language, "exportWeeklyReport"); clicked => root.export-report(false); }
                    SmallButton { width: 142px; label: I18n.tr(I18n.language, "exportMonthlyReport"); clicked => root.export-report(true); }
                }
            }
        }
    }

    OverlayLayer {
        onboarding-visible <=> root.onboarding-visible;
        onboarding-step <=> root.onboarding-step;
        settings-open <=> root.settings-open;
        settings-tab <=> root.settings-tab;
        settings-nick <=> root.settings-nick;
        settings-frontmatter <=> root.settings-frontmatter;
        settings-estimate-key <=> root.settings-estimate-key;
        settings-time-format <=> root.settings-time-format;
        settings-obsidian-vault <=> root.settings-obsidian-vault;
        settings-stats-fields <=> root.settings-stats-fields;
        settings-language <=> root.settings-language;
        settings-daily-goal <=> root.settings-daily-goal;
        settings-auto-refresh <=> root.settings-auto-refresh;
        settings-notifications <=> root.settings-notifications;
        settings-notification-interval <=> root.settings-notification-interval;
        settings-limit-enabled <=> root.settings-limit-enabled;
        settings-limit-sound-enabled <=> root.settings-limit-sound-enabled;
        settings-limit-sound-path <=> root.settings-limit-sound-path;
        settings-limit-notification-enabled <=> root.settings-limit-notification-enabled;
        settings-limit-overlay <=> root.settings-limit-overlay;
        settings-limit-message <=> root.settings-limit-message;
        updater-status <=> root.updater-status;
        update-available <=> root.update-available;
        new-note-open <=> root.new-note-open;
        new-note-filename <=> root.new-note-filename;
        new-note-time <=> root.new-note-time;
        new-note-tags <=> root.new-note-tags;
        close-guard-open <=> root.close-guard-open;
        preview-open <=> root.preview-open;
        preview-title <=> root.preview-title;
        preview-path <=> root.preview-path;
        preview-body <=> root.preview-body;
        edit-note-open <=> root.edit-note-open;
        edit-note-title <=> root.edit-note-title;
        edit-note-path <=> root.edit-note-path;
        edit-note-time <=> root.edit-note-time;
        custom-estimate-open <=> root.custom-estimate-open;
        custom-estimate-index <=> root.custom-estimate-index;
        custom-estimate-value <=> root.custom-estimate-value;
        expiration-overlay-open <=> root.expiration-overlay-open;
        expiration-overlay-title <=> root.expiration-overlay-title;
        expiration-overlay-message <=> root.expiration-overlay-message;
        vault-path: root.vault-path;
        profiles: root.profiles;
        choose-folder => root.choose-folder();
        save-settings => root.save-settings();
        create-note => root.create-note();
        close-save-all => root.close-save-all();
        close-discard-all => root.close-discard-all();
        save-note-edit => root.save-note-edit();
        save-custom-estimate(index, value) => root.save-custom-estimate(index, value);
        switch-profile(index) => root.switch-profile(index);
        create-profile => root.create-profile();
        delete-profile(index) => root.delete-profile(index);
        complete-onboarding => root.complete-onboarding();
        choose-alert-sound => root.choose-alert-sound();
        check-update => root.check-update();
        install-update => root.install-update();
    }
}
