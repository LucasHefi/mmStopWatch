{
  "name": "mmstopwatch",
  "private": true,
  "version": "1.7.0-rc.3",
  "author": "Lukáš Hefner (mediamaker.cz)",
  "description": "Stopwatch for Obsidian & etc.",
  "homepage": "https://mediamaker.cz",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mmstopwatch": "cli/mmstopwatch.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "tauri:build:linux": "tauri build --bundles deb,appimage",
    "tauri:build:macos": "tauri build --bundles dmg,app",
    "tauri:build:windows": "tauri build --bundles nsis,msi",
    "control-plane:dev": "tsx tools/control-plane-http.ts",
    "mcp:stdio": "tsx tools/mcp-stdio.ts",
    "cli": "node cli/mmstopwatch.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:2.0": "node scripts/run-2.0-verification.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
