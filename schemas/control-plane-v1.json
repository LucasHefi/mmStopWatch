{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediamaker.cz/mmstopwatch/schemas/control-plane-v1.json",
  "title": "mmStopWatch control-plane protocol v1",
  "description": "Versioned local control-plane command, envelope, and HTTP read-route contract. Runtime capabilities remain authoritative for available handlers.",
  "protocolVersion": "1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "commandRegistry", "routes", "responseSchemas"],
  "properties": {
    "protocolVersion": {
      "const": "1"
    },
    "commandRegistry": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/commandDefinition"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/httpRoute"
      }
    },
    "responseSchemas": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/schemaReference"
      }
    }
  },
  "$defs": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "commandName": {
      "type": "string",
      "enum": [
        "status",
        "capabilities",
        "list_notes",
        "get_stats",
        "preview_report",
        "timer_start",
        "timer_pause",
        "timer_resume",
        "timer_stop",
        "timer_get",
        "timer_list",
        "note_list",
        "note_get",
        "note_save",
        "note_update",
        "note_delete",
        "profile_list",
        "config_get",
        "notification_status"
      ]
    },
    "commandDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "mutating"],
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["status", "timer", "note", "report", "profile", "config", "notification"]
        },
        "mutating": {
          "type": "boolean"
        }
      }
    },
    "commandRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "actor", "command", "input"],
      "properties": {
        "protocolVersion": {
          "const": "1"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "actor": {
          "type": "string",
          "enum": ["ui", "http", "mcp", "cli"]
        },
        "command": {
          "$ref": "#/$defs/commandName"
        },
        "input": {
          "type": "object"
        },
        "expectedRevision": {
          "$ref": "#/$defs/revision"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "confirmation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "safeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["INVALID_REQUEST", "UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "CONFLICT", "NOT_IMPLEMENTED", "INTERNAL"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    },
    "successEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "protocolVersion", "requestId", "data"],
      "properties": {
        "ok": {
          "const": true
        },
        "protocolVersion": {
          "const": "1"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "data": {},
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "protocolVersion", "requestId", "error"],
      "properties": {
        "ok": {
          "const": false
        },
        "protocolVersion": {
          "const": "1"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "error": {
          "$ref": "#/$defs/safeError"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "name", "durationMs", "tags", "hasFrontmatter"],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hasFrontmatter": {
          "type": "boolean"
        }
      }
    },
    "timer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "notePath", "name", "status", "elapsedMs", "baseElapsedMs", "pausedOffsetMs"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "notePath": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["IDLE", "RUNNING", "PAUSED", "STOPPED"]
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "baseElapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "pausedOffsetMs": {
          "type": "number",
          "minimum": 0
        },
        "startedAtMs": {
          "type": "number",
          "minimum": 0
        },
        "timeEstimateMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "active"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nick": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "statusOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appVersion", "protocolVersion", "ready"],
      "properties": {
        "appVersion": {
          "type": "string",
          "minLength": 1
        },
        "protocolVersion": {
          "const": "1"
        },
        "ready": {
          "type": "boolean"
        },
        "activeProfileId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilitiesOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "readOnly", "commands"],
      "properties": {
        "protocolVersion": {
          "const": "1"
        },
        "readOnly": {
          "const": true
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandName"
          }
        }
      }
    },
    "noteListOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes"],
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "noteGetOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "timerListOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timers", "revision"],
      "properties": {
        "timers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timer"
          }
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "profileListOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles"],
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "activeProfileId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "configGetOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config"],
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileCount"],
          "properties": {
            "activeProfileId": { "type": "string", "minLength": 1 },
            "profileCount": { "type": "integer", "minimum": 0 },
            "frontmatterKey": { "type": "string", "minLength": 1 },
            "timeEstimateKey": { "type": "string", "minLength": 1 },
            "timeFormat": { "type": "string", "minLength": 1 },
            "language": { "type": "string", "minLength": 1 },
            "dailyGoalMs": { "type": "number", "minimum": 0 },
            "autoRefreshInterval": { "type": "number", "minimum": 0 },
            "notificationsEnabled": { "type": "boolean" }
          }
        }
      }
    },
    "notificationStatusOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notifications"],
      "properties": {
        "notifications": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "intervalMinutes": { "type": "number", "minimum": 0 },
            "soundEnabled": { "type": "boolean" },
            "notificationsEnabled": { "type": "boolean" },
            "showOverlay": { "type": "boolean" }
          }
        }
      }
    },
    "statsOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalDurationMs", "sessionCount", "noteCount"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "totalDurationMs": { "type": "number", "minimum": 0 },
        "sessionCount": { "type": "integer", "minimum": 0 },
        "noteCount": { "type": "integer", "minimum": 0 }
      }
    },
    "reportPreviewOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "content", "truncated"],
      "properties": {
        "format": { "const": "markdown" },
        "content": { "type": "string" },
        "truncated": { "type": "boolean" }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "command", "readOnly", "responseSchema"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST"]
        },
        "path": {
          "type": "string",
          "pattern": "^/api/v1/"
        },
        "command": {
          "$ref": "#/$defs/commandName"
        },
        "readOnly": {
          "const": true
        },
        "responseSchema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^#/$defs/"
        }
      }
    }
  },
  "commandRegistry": {
    "status": { "domain": "status", "mutating": false },
    "capabilities": { "domain": "status", "mutating": false },
    "list_notes": { "domain": "note", "mutating": false },
    "get_stats": { "domain": "report", "mutating": false },
    "preview_report": { "domain": "report", "mutating": false },
    "timer_start": { "domain": "timer", "mutating": true },
    "timer_pause": { "domain": "timer", "mutating": true },
    "timer_resume": { "domain": "timer", "mutating": true },
    "timer_stop": { "domain": "timer", "mutating": true },
    "timer_get": { "domain": "timer", "mutating": false },
    "timer_list": { "domain": "timer", "mutating": false },
    "note_list": { "domain": "note", "mutating": false },
    "note_get": { "domain": "note", "mutating": false },
    "note_save": { "domain": "note", "mutating": true },
    "note_update": { "domain": "note", "mutating": true },
    "note_delete": { "domain": "note", "mutating": true },
    "profile_list": { "domain": "profile", "mutating": false },
    "config_get": { "domain": "config", "mutating": false },
    "notification_status": { "domain": "notification", "mutating": false }
  },
  "routes": [
    { "method": "GET", "path": "/api/v1/status", "command": "status", "readOnly": true, "responseSchema": "statusOutput" },
    { "method": "GET", "path": "/api/v1/capabilities", "command": "capabilities", "readOnly": true, "responseSchema": "capabilitiesOutput" },
    { "method": "GET", "path": "/api/v1/timers", "command": "timer_list", "readOnly": true, "responseSchema": "timerListOutput" },
    { "method": "GET", "path": "/api/v1/notes", "command": "list_notes", "readOnly": true, "responseSchema": "noteListOutput" },
    { "method": "GET", "path": "/api/v1/notes?path={relativePath}", "command": "note_get", "readOnly": true, "responseSchema": "noteGetOutput" },
    { "method": "GET", "path": "/api/v1/stats", "command": "get_stats", "readOnly": true, "responseSchema": "statsOutput" },
    { "method": "POST", "path": "/api/v1/reports/preview", "command": "preview_report", "readOnly": true, "responseSchema": "reportPreviewOutput" },
    { "method": "GET", "path": "/api/v1/profiles", "command": "profile_list", "readOnly": true, "responseSchema": "profileListOutput" },
    { "method": "GET", "path": "/api/v1/config", "command": "config_get", "readOnly": true, "responseSchema": "configGetOutput" },
    { "method": "GET", "path": "/api/v1/notifications", "command": "notification_status", "readOnly": true, "responseSchema": "notificationStatusOutput" }
  ],
  "responseSchemas": {
    "status": { "$ref": "#/$defs/statusOutput" },
    "capabilities": { "$ref": "#/$defs/capabilitiesOutput" },
    "list_notes": { "$ref": "#/$defs/noteListOutput" },
    "note_get": { "$ref": "#/$defs/noteGetOutput" },
    "timer_list": { "$ref": "#/$defs/timerListOutput" },
    "profile_list": { "$ref": "#/$defs/profileListOutput" },
    "config_get": { "$ref": "#/$defs/configGetOutput" },
    "notification_status": { "$ref": "#/$defs/notificationStatusOutput" },
    "get_stats": { "$ref": "#/$defs/statsOutput" },
    "preview_report": { "$ref": "#/$defs/reportPreviewOutput" }
  }
}
