{
  "mcpServers": {
    "mmstopwatch": {
      "command": "npm",
      "args": ["--silent", "run", "mcp:stdio"],
      "cwd": "<project-root>",
      "env": {
        "MMSTOPWATCH_CONTROL_PLANE_URL": "http://127.0.0.1:9376",
        "MMSTOPWATCH_CONTROL_PLANE_TOKEN": "<provide-through-your-secret-store>"
      },
      "timeout": 30,
      "connect_timeout": 10
    }
  }
}
